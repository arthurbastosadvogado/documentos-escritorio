<style>
:root{
  --paper:#F4F5F7; --surface:#FFFFFF; --ink:#1F2A3C; --text:#1E2430; --muted:#5D6776;
  --rule:#D7DCE3; --rule-strong:#B9C1CC; --mark:#FFEE58; --mark-ink:#2A2600; --ok:#2E6A4D; --warn:#8A4B12;
  --band:#1F2A3C; --band-ink:#F2F4F7; --focus:#3B5B8C;
  --serif:"Spectral", Georgia, "Times New Roman", serif;
  --sans:"Public Sans", system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --paper:#11151B; --surface:#181E26; --ink:#DCE3EE; --text:#E3E7ED; --muted:#9AA4B3;
    --rule:#2B333F; --rule-strong:#3B4553; --mark:#E9D94A; --mark-ink:#201C00; --ok:#79C29C; --warn:#E3A867;
    --band:#0C1117; --band-ink:#E8ECF2; --focus:#8FB0E0;
  }
}
:root[data-theme="dark"]{
  --paper:#11151B; --surface:#181E26; --ink:#DCE3EE; --text:#E3E7ED; --muted:#9AA4B3;
  --rule:#2B333F; --rule-strong:#3B4553; --mark:#E9D94A; --mark-ink:#201C00; --ok:#79C29C; --warn:#E3A867;
  --band:#0C1117; --band-ink:#E8ECF2; --focus:#8FB0E0;
}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--paper);color:var(--text);font:400 15px/1.55 var(--sans)}
header.band{background:var(--band);color:var(--band-ink)}
.band-in{max-width:1180px;margin:0 auto;padding:22px 24px 26px;display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap}
.mono{font-family:var(--serif);font-weight:600;font-size:15px;letter-spacing:.02em;opacity:.8}
h1{font-family:var(--serif);font-weight:500;font-size:clamp(26px,4vw,36px);line-height:1.15;margin:6px 0 0}
.band p{margin:6px 0 0;max-width:60ch;opacity:.82;font-size:14px}
.layout{max-width:1180px;margin:0 auto;padding:28px 24px 80px;display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:36px;align-items:start}
@media (max-width:920px){.layout{grid-template-columns:1fr}.aside{position:static!important}}
fieldset{border:0;border-top:1px solid var(--rule-strong);margin:0 0 30px;padding:18px 0 0;min-width:0}
legend{font-family:var(--serif);font-weight:600;font-size:22px;color:var(--ink);padding:0 12px 0 0}
.hint{color:var(--muted);font-size:13.5px;margin:2px 0 14px;max-width:70ch}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 16px}
.grid .full{grid-column:1/-1}
@media (max-width:560px){.grid{grid-template-columns:1fr}}
label.f{display:flex;flex-direction:column;gap:5px;font-size:13px;font-weight:500;color:var(--muted)}
input[type=text],input[type=date],input[type=email],input[type=tel],input[type=password],input[type=search],select,textarea{
  font:inherit;font-size:15px;color:var(--text);background:var(--surface);border:1px solid var(--rule-strong);border-radius:6px;padding:9px 11px;width:100%;min-width:0}
textarea{resize:vertical;min-height:64px}
input:focus,select:focus,textarea:focus,button:focus-visible{outline:2px solid var(--focus);outline-offset:1px}
input.empty,textarea.empty{background:color-mix(in srgb,var(--mark) 22%,var(--surface))}
.choice{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
@media (max-width:720px){.choice{grid-template-columns:repeat(2,minmax(0,1fr))}}
.choice label{border:1px solid var(--rule-strong);border-radius:8px;padding:12px;background:var(--surface);cursor:pointer;display:flex;flex-direction:column;gap:3px}
.choice label b{font-family:var(--serif);font-weight:600;font-size:16px;color:var(--ink)}
.choice label span{font-size:12.5px;color:var(--muted)}
.choice input{position:absolute;opacity:0;pointer-events:none}
.choice label:has(input:checked){border-color:var(--ink);box-shadow:inset 0 0 0 1px var(--ink)}
.choice label:has(input:focus-visible){outline:2px solid var(--focus);outline-offset:1px}
.checks{display:flex;gap:18px;flex-wrap:wrap;margin-top:14px}
.chk{display:flex;align-items:center;gap:8px;font-size:14.5px;cursor:pointer}
.chk input{width:18px;height:18px;accent-color:var(--ink)}
.person{border:1px solid var(--rule);background:var(--surface);border-radius:8px;padding:14px 16px 16px;margin-bottom:12px}
.person-h{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px;flex-wrap:wrap}
.person-h strong{font-family:var(--serif);font-size:17px;color:var(--ink);font-weight:600}
.seg{display:inline-flex;border:1px solid var(--rule-strong);border-radius:6px;overflow:hidden}
.seg button{border:0;background:transparent;color:var(--muted);font:500 13px var(--sans);padding:6px 12px;cursor:pointer}
.seg button[aria-pressed="true"]{background:var(--ink);color:var(--surface)}
button.btn{font:600 14px var(--sans);border-radius:6px;padding:9px 14px;cursor:pointer;border:1px solid var(--ink);background:var(--ink);color:var(--surface)}
button.ghost{background:transparent;color:var(--ink)}
button.link{background:none;border:0;color:var(--muted);font:500 13px var(--sans);cursor:pointer;text-decoration:underline;padding:4px}
button:disabled{opacity:.5;cursor:default}
.fixed-adv{font-size:14px;padding:10px 0 12px;border-bottom:1px dashed var(--rule);margin-bottom:12px}
.fixed-adv b{font-family:var(--serif);font-weight:600;color:var(--ink)}
.sub{font-family:var(--serif);font-weight:600;font-size:16.5px;color:var(--ink);margin:18px 0 8px}
.opt{border-left:3px solid var(--rule-strong);padding:4px 0 4px 14px;margin:12px 0}
.tbl{width:100%;border-collapse:collapse;font-size:14px;margin-top:10px}
.tbl th{font-weight:600;text-align:left;color:var(--muted);font-size:12.5px;padding:6px 6px;border-bottom:1px solid var(--rule-strong)}
.tbl td{padding:5px 6px;border-bottom:1px solid var(--rule)}
.tbl-wrap{overflow-x:auto}
.sumline{font-size:13.5px;margin-top:8px;color:var(--muted)}
.sumline.bad{color:var(--warn);font-weight:600}
.row{display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap}
.row > label.f{flex:1 1 140px}
.aside{position:sticky;top:16px}
.folder{background:var(--surface);border:1px solid var(--rule-strong);border-radius:10px;padding:18px 18px 16px}
.folder h2{font-family:var(--serif);font-weight:600;font-size:20px;margin:0 0 4px;color:var(--ink)}
.folder .who{font-size:13.5px;color:var(--muted);margin:0 0 12px;min-height:1.4em}
.doc{border-top:1px solid var(--rule);padding:12px 0}
.doc-h{display:flex;justify-content:space-between;align-items:baseline;gap:8px}
.doc-name{font-family:var(--serif);font-weight:600;font-size:16px;color:var(--ink)}
.state{font-size:12.5px;font-weight:600;white-space:nowrap}
.state.ok{color:var(--ok)}
.state.pend{color:var(--warn)}
.chips{display:flex;flex-wrap:wrap;gap:5px;margin:8px 0 10px}
.chip{background:var(--mark);color:var(--mark-ink);font-size:12px;padding:1px 6px;border-radius:2px}
.doc .btn{width:100%;margin-top:4px}
.folder-foot{border-top:1px solid var(--rule);padding-top:12px}
.msg{font-size:13px;color:var(--muted);margin:10px 0 0;min-height:1.2em}
.msg.err{color:var(--warn)}
.empty-folder{font-size:14px;color:var(--muted);padding:8px 0}
.theme{background:none;border:1px solid color-mix(in srgb,var(--band-ink) 40%,transparent);color:var(--band-ink);font:500 12.5px var(--sans);border-radius:6px;padding:6px 10px;cursor:pointer}
[hidden]{display:none!important}
.auth{min-height:calc(100vh - 160px);display:flex;align-items:flex-start;justify-content:center;padding:48px 20px}
.auth-card{width:100%;max-width:400px;background:var(--surface);border:1px solid var(--rule-strong);border-radius:10px;padding:24px;display:flex;flex-direction:column;gap:12px}
.auth-card h2{font-family:var(--serif);font-weight:600;font-size:24px;margin:0;color:var(--ink)}
.auth-card .btn{margin-top:4px}
.top-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.who-band{font-size:13px;opacity:.85}
.cases{background:var(--surface);border:1px solid var(--rule-strong);border-radius:10px;padding:16px 18px;margin-bottom:28px}
.cases-h{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap;margin-bottom:12px}
.cases-title{font-family:var(--serif);font-weight:600;font-size:20px;color:var(--ink)}
.cases-cur{font-size:13.5px;color:var(--muted)}
.cases-cur.dirty{color:var(--warn);font-weight:600}
.cases-actions{display:flex;gap:8px}
.case-list{list-style:none;margin:10px 0 0;padding:0;max-height:260px;overflow:auto;border-top:1px solid var(--rule)}
.case-list li{display:flex;align-items:center;gap:8px;border-bottom:1px solid var(--rule)}
.case-list button.open{flex:1;text-align:left;background:none;border:0;padding:9px 4px;cursor:pointer;color:var(--text);font:inherit;display:flex;flex-direction:column}
.case-list button.open:hover b{text-decoration:underline}
.case-list b{font-weight:600;color:var(--ink)}
.case-list small{color:var(--muted);font-size:12.5px}
.case-list li.cur{background:color-mix(in srgb,var(--mark) 18%,transparent)}
.case-empty{color:var(--muted);font-size:13.5px;padding:10px 4px}
@media (prefers-reduced-motion:no-preference){.doc,.person{transition:border-color .15s}}
</style>
</head>
<body>
<header class="band">
  <div class="band-in">
    <div>
      <div class="mono">Arthur Bastos Advocacia e Consultoria Jurídica</div>
      <h1>Documentos do cliente</h1>
      <p>Preencha os dados uma vez e baixe contrato, procuração e declaração já completos, no papel timbrado. O que ficar em branco sai no documento como linha amarela para completar.</p>
    </div>
    <div class="top-actions">
      <span class="who-band" id="userEmail" hidden></span>
      <button class="theme" id="logoutBtn" type="button" hidden>Sair</button>
      <button class="theme" id="themeBtn" type="button">Tema escuro</button>
    </div>
  </div>
</header>

<div class="auth" id="auth">
  <div class="auth-card" id="setupCard" hidden>
    <h2>Falta conectar o banco de dados</h2>
    <p class="hint">Abra este arquivo (index.html) num editor de texto e preencha SUPABASE_URL e SUPABASE_ANON_KEY no topo, como explica o passo a passo do README.</p>
  </div>
  <form class="auth-card" id="loginForm" hidden>
    <h2>Entrar</h2>
    <p class="hint">Use o e-mail e a senha cadastrados para você no escritório.</p>
    <label class="f">E-mail<input type="email" id="loginEmail" autocomplete="username" required></label>
    <label class="f">Senha<input type="password" id="loginPass" autocomplete="current-password" required></label>
    <button class="btn" type="submit" id="loginBtn">Entrar</button>
    <button class="link" type="button" id="forgotBtn">Esqueci minha senha</button>
    <p class="msg" id="authMsg" role="status" aria-live="polite"></p>
  </form>
  <form class="auth-card" id="newPassForm" hidden>
    <h2>Criar nova senha</h2>
    <label class="f">Nova senha (mínimo 8 caracteres)<input type="password" id="newPass" autocomplete="new-password" minlength="8" required></label>
    <label class="f">Repita a nova senha<input type="password" id="newPass2" autocomplete="new-password" minlength="8" required></label>
    <button class="btn" type="submit">Salvar nova senha</button>
    <p class="msg" id="newPassMsg" role="status" aria-live="polite"></p>
  </form>
</div>
<div class="layout" id="app" hidden>
<main id="form">
<section class="cases" aria-label="Cadastro de clientes">
  <div class="cases-h">
    <div><div class="cases-title">Cadastro de clientes</div><div class="cases-cur" id="curCase">Novo cliente, ainda não salvo</div></div>
    <div class="cases-actions"><button class="btn ghost" type="button" id="newCase">Novo cliente</button><button class="btn" type="button" id="saveCase">Salvar</button></div>
  </div>
  <input type="search" id="caseSearch" placeholder="Buscar cliente salvo por nome, CPF ou CNPJ" aria-label="Buscar cliente salvo">
  <ul class="case-list" id="caseList"></ul>
  <p class="msg" id="caseMsg" role="status" aria-live="polite"></p>
</section>

<fieldset>
  <legend>Documentos</legend>
  <p class="hint">Escolha o contrato e marque os demais documentos que vai gerar.</p>
  <div class="choice" role="radiogroup" aria-label="Tipo de contrato">
    <label><input type="radio" name="contrato" value="exito"><b>Só êxito</b><span>Percentual sobre o proveito, sem entrada</span></label>
    <label><input type="radio" name="contrato" value="inicial"><b>Entrada + êxito</b><span>Valor fixo inicial e percentual</span></label>
    <label><input type="radio" name="contrato" value="fixo"><b>Fixo por instância</b><span>1º grau, 2º grau e Superiores</span></label>
    <label><input type="radio" name="contrato" value="nenhum"><b>Sem contrato</b><span>Só procuração ou declaração</span></label>
  </div>
  <div class="checks">
    <label class="chk"><input type="checkbox" data-k="gerarProc"> Procuração</label>
    <label class="chk"><input type="checkbox" data-k="gerarDecl"> Declaração de hipossuficiência</label>
  </div>
</fieldset>

<fieldset>
  <legend>Cliente</legend>
  <p class="hint">Cadastre cada contratante. Para empresa, use “Pessoa jurídica” e informe o representante.</p>
  <div id="cts"></div>
  <button class="btn ghost" type="button" id="addCt">Adicionar outro contratante</button>
</fieldset>

<fieldset>
  <legend>Advogados</legend>
  <div class="fixed-adv"><b>Dr. Arthur Bastos Barcelos</b>, OAB/MG 246.787, pela Arthur Bastos Barcelos Sociedade Individual de Advocacia, já entra em todos os documentos.</div>
  <div class="grid">
    <label class="f">Registro da sociedade na OAB/MG<input type="text" data-k="socReg" data-save="1" placeholder="nº de registro"></label>
    <label class="f" data-show="pagamento">Plataforma do link de cartão<input type="text" data-k="plataforma" data-save="1" placeholder="ex.: InfinitePay"></label>
  </div>
  <p class="hint" style="margin-top:10px">Esses dois campos e os advogados extras ficam salvos no banco de dados para todo o escritório.</p>
  <div class="sub">Outros advogados neste caso</div>
  <div id="advs"></div>
  <button class="btn ghost" type="button" id="addAdv">Adicionar advogado(a)</button>
</fieldset>

<fieldset data-show="caso">
  <legend>O caso</legend>
  <div data-show="obj12">
    <div class="grid">
      <label class="f full">Serviço contratado<textarea data-k="objServico" rows="2" placeholder="ex.: ajuizamento e acompanhamento de ação de indenização por danos morais e materiais"></textarea></label>
      <label class="f">Parte contrária<input type="text" data-k="parte" placeholder="nome ou razão social"></label>
      <label class="f">Resultado buscado<input type="text" data-k="objResultado" placeholder="ex.: a reparação dos danos sofridos"></label>
      <label class="f full">O patrocínio vai até<input type="text" data-k="extensao"></label>
      <label class="f full">Outra exclusão do contrato (opcional)<input type="text" data-k="exclusao" data-optional="1" placeholder="deixe vazio se não houver"></label>
    </div>
  </div>
  <div data-show="obj3">
    <div class="grid">
      <label class="f">Atuação
        <select data-k="atuacao"><option value="ajuizamento">Ajuizar a ação (autor)</option><option value="defesa">Defender o cliente (réu)</option></select></label>
      <label class="f">Ação<input type="text" data-k="objAcao" placeholder="ex.: ação de cobrança"></label>
      <label class="f">Parte contrária<input type="text" data-k="parte" placeholder="nome ou razão social"></label>
      <label class="f">Nº do processo (se já existir)<input type="text" data-k="processo" data-optional="1" placeholder="0000000-00.0000.0.00.0000"></label>
      <label class="f full">Juízo (se já existir)<input type="text" data-k="juizo" data-optional="1" placeholder="ex.: a 10ª Vara Cível da Comarca de Belo Horizonte"></label>
      <label class="f">Tribunal de 2º grau<input type="text" data-k="f2Trib"></label>
      <label class="f">Tribunais Superiores<input type="text" data-k="f3Trib"></label>
      <label class="f">Agravo de instrumento no 1º grau
        <select data-k="agravo"><option value="f1">Incluído na Fase 1</option><option value="f2">Cobrado como Fase 2</option></select></label>
      <label class="f">Cumprimento de sentença
        <select data-k="cumpr"><option value="incluso">Incluído na fase do trânsito em julgado</option><option value="proprio">Honorários próprios</option></select></label>
      <label class="f" data-show="cumprProprio">Valor do cumprimento de sentença<input type="text" data-k="cumprValor" data-money="1" placeholder="R$"></label>
    </div>
  </div>
  <div data-show="procOnly" class="grid" style="margin-top:12px">
    <label class="f full">Finalidade da procuração<textarea data-k="finalidade" data-optional="1" rows="2" id="finalidade"></textarea></label>
  </div>
</fieldset>

<fieldset data-show="honorarios">
  <legend>Honorários</legend>
  <div data-show="t2">
    <div class="grid">
      <label class="f">Valor total da entrada (honorários iniciais)<input type="text" data-k="iniTotal" data-money="1" placeholder="R$"></label>
      <label class="f">A entrada remunera a elaboração da<input type="text" data-k="iniPeca"></label>
      <label class="f">A entrada será abatida do êxito?
        <select data-k="abate"><option value="nao">Não</option><option value="sim">Sim</option></select></label>
      <label class="f">Entrada fica integralmente devida depois de<input type="text" data-k="atoPrincipal"></label>
    </div>
  </div>
  <div data-show="t3">
    <div class="grid">
      <label class="f">Fase 1 – Primeiro grau<input type="text" data-k="f1" data-money="1" placeholder="R$"></label>
      <label class="f">Fase 2 – Segundo grau (adicional)<input type="text" data-k="f2" data-money="1" placeholder="R$"></label>
      <label class="f">Fase 3 – Tribunais Superiores (adicional)<input type="text" data-k="f3" data-money="1" placeholder="R$"></label>
      <label class="f">Fases 2 e 3 pagas em até<select data-k="f23Parc"><option value="1">À vista</option><option value="2">2 parcelas</option><option value="3">3 parcelas</option><option value="4">4 parcelas</option><option value="5">5 parcelas</option><option value="6">6 parcelas</option></select></label>
    </div>
  </div>
  <div data-show="exitoAny">
    <div class="grid" style="margin-top:12px">
      <label class="f">Percentual de êxito (%)<input type="text" data-k="pct" inputmode="decimal"></label>
      <label class="f">Honorários em obrigação de fazer<input type="text" data-k="fazer" data-money="1" placeholder="R$"></label>
      <label class="f" data-show="t1">Valor mínimo se o cliente revogar<input type="text" data-k="minimo" data-money="1" placeholder="R$"></label>
    </div>
    <div class="opt">
      <label class="chk"><input type="checkbox" data-k="rec"> Majorar o percentual se o caso chegar aos Tribunais Superiores</label>
      <div class="grid" data-show="rec" style="margin-top:10px">
        <label class="f">Percentual nessa fase (%)<input type="text" data-k="recPct" inputmode="decimal"></label>
        <label class="f">Tribunais<input type="text" data-k="recTrib"></label>
      </div>
    </div>
    <div class="opt">
      <label class="chk"><input type="checkbox" data-k="per"> Causa com prestações periódicas (ex.: previdenciária)</label>
      <div class="grid" data-show="per" style="margin-top:10px">
        <label class="f">Parcelas vincendas na base de cálculo<input type="text" data-k="perParc" inputmode="numeric"></label>
      </div>
    </div>
  </div>
  <div class="grid" style="margin-top:12px">
    <label class="f">Multa por atraso (%)<input type="text" data-k="multa" inputmode="decimal"></label>
    <label class="f" data-show="multiCt">Com mais de um cliente, o pagamento é
      <select data-k="solid"><option value="solidario">Solidário entre todos</option><option value="iguais">Em partes iguais</option></select></label>
  </div>
</fieldset>

<fieldset data-show="pagamento">
  <legend id="pagLegend">Pagamento</legend>
  <p class="hint">Gere as parcelas automaticamente e ajuste datas, valores ou forma de pagamento linha a linha.</p>
  <div class="row">
    <label class="f">Total<input type="text" id="genTotal" data-money="1" placeholder="R$"></label>
    <label class="f">Parcelas<input type="text" id="genN" inputmode="numeric" value="1"></label>
    <label class="f">1º vencimento<input type="date" id="genData"></label>
    <label class="f">Forma<select id="genForma"><option>PIX</option><option>Cartão de crédito</option><option>PIX ou cartão</option></select></label>
    <button class="btn" type="button" id="genBtn">Gerar parcelas</button>
  </div>
  <div class="tbl-wrap">
    <table class="tbl" id="parcTbl">
      <thead><tr><th>Parcela</th><th>Vencimento</th><th>Valor</th><th>Forma</th><th><span class="sr" hidden>Remover</span></th></tr></thead>
      <tbody></tbody>
    </table>
  </div>
  <div class="row" style="margin-top:8px">
    <button class="link" type="button" id="addParc">Adicionar parcela</button>
  </div>
  <p class="sumline" id="sumLine"></p>
  <div class="grid" style="margin-top:8px">
    <label class="f" data-show="multiParc">Serviço começa após o pagamento
      <select data-k="inicio"><option value="entrada">Da entrada (1ª parcela)</option><option value="integral">Do valor integral</option></select></label>
    <label class="f full">Prazo crítico informado ao cliente<input type="text" data-k="prazoCritico"></label>
  </div>
</fieldset>

<fieldset data-show="contrato">
  <legend>Conta do cliente</legend>
  <p class="hint">Para o repasse dos valores recebidos no processo. Pode deixar em branco e completar depois.</p>
  <div class="grid">
    <label class="f">Banco<input type="text" data-k="cliBanco" placeholder="nome e código"></label>
    <label class="f">Agência<input type="text" data-k="cliAg"></label>
    <label class="f">Conta<input type="text" data-k="cliConta"></label>
    <label class="f">Chave PIX<input type="text" data-k="cliPix"></label>
  </div>
</fieldset>

<fieldset data-show="decl">
  <legend>Declaração de hipossuficiência</legend>
  <div class="grid">
    <label class="f">Declarante<select id="declSel"></select></label>
  </div>
  <div class="opt">
    <label class="chk"><input type="checkbox" data-k="sit"> Informar a situação econômica (recomendado pelo Tema 1178)</label>
    <div class="grid" data-show="sit" style="margin-top:10px">
      <label class="f">Renda mensal aproximada<input type="text" data-k="renda" data-money="1" placeholder="R$"></label>
      <label class="f">Dependentes<input type="text" data-k="dependentes" inputmode="numeric"></label>
      <label class="f full">Principais despesas fixas<input type="text" data-k="despesas" placeholder="aluguel, saúde, educação…"></label>
    </div>
  </div>
</fieldset>

<fieldset>
  <legend>Assinatura</legend>
  <div class="grid">
    <label class="f">Data<input type="date" data-k="data"></label>
    <div></div>
    <label class="f" data-show="contrato">Testemunha 1 (opcional)<input type="text" data-k="T1_NOME" data-optional="1" placeholder="nome"></label>
    <label class="f" data-show="contrato">CPF<input type="text" data-k="T1_CPF" data-optional="1" data-mask="cpf"></label>
    <label class="f" data-show="contrato">Testemunha 2 (opcional)<input type="text" data-k="T2_NOME" data-optional="1" placeholder="nome"></label>
    <label class="f" data-show="contrato">CPF<input type="text" data-k="T2_CPF" data-optional="1" data-mask="cpf"></label>
  </div>
  
</fieldset>
</main>

<aside class="aside" aria-label="Documentos a gerar">
  <div class="folder">
    <h2>Pasta do cliente</h2>
    <p class="who" id="who"></p>
    <div id="docs"></div>
    <div class="folder-foot" id="foot">
      <button class="btn" type="button" id="dlAll" style="width:100%">Baixar todos (.zip)</button>
      <p class="msg" id="msg" role="status" aria-live="polite"></p>
    </div>
  </div>
</aside>
</div>

<script>
/* Motor de preenchimento dos modelos .docx (document.xml) */
var DocEngine = (function () {
  var W = 'http://schemas.openxmlformats.org/wordprocessingml/2006/main';
  var BLANK = '______________';

  function els(node, name) {
    var out = [], list = node.getElementsByTagNameNS(W, name);
    for (var i = 0; i < list.length; i++) out.push(list[i]);
    return out;
  }
  function textOf(node) {
    return els(node, 't').map(function (t) { return t.textContent; }).join('');
  }
  function markerOf(node) {
    var m = textOf(node).match(/⟦([^⟧]+)⟧/);
    return m ? m[1] : null;
  }
  function nextEl(n) {
    n = n.nextSibling;
    while (n && n.nodeType !== 1) n = n.nextSibling;
    return n;
  }

  // Escreve texto num <w:t>; trechos em branco viram runs destacados em amarelo
  function setText(t, text) {
    var run = t.parentNode;
    if (text.indexOf(BLANK) < 0 || !run || run.localName !== 'r') {
      t.textContent = text;
      return;
    }
