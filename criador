id=\"rId10\" w:type=\"default\"/><w:pgSz w:h=\"16838\" w:w=\"11906\" w:orient=\"portrait\"/><w:pgMar w:bottom=\"1440\" w:top=\"1440\" w:left=\"1440\" w:right=\"1440\" w:header=\"0\" w:footer=\"0\" w:gutter=\"0\"/><w:pgNumType w:start=\"1\"/><\/w:sectPr><\/w:body><\/w:document>", "t_content_decl": "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n<w:document xmlns:mc=\"http://schemas.openxmlformats.org/markup-compatibility/2006\" xmlns:o=\"urn:schemas-microsoft-com:office:office\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\" xmlns:m=\"http://schemas.openxmlformats.org/officeDocument/2006/math\" xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:wp=\"http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing\" xmlns:w10=\"urn:schemas-microsoft-com:office:word\" xmlns:w=\"http://schemas.openxmlformats.org/wordprocessingml/2006/main\" xmlns:wne=\"http://schemas.microsoft.com/office/word/2006/wordml\" xmlns:sl=\"http://schemas.openxmlformats.org/schemaLibrary/2006/main\" xmlns:a=\"http://schemas.openxmlformats.org/drawingml/2006/main\" xmlns:pic=\"http://schemas.openxmlformats.org/drawingml/2006/picture\" xmlns:c=\"http://schemas.openxmlformats.org/drawingml/2006/chart\" xmlns:lc=\"http://schemas.openxmlformats.org/drawingml/2006/lockedCanvas\" xmlns:dgm=\"http://schemas.openxmlformats.org/drawingml/2006/diagram\" xmlns:wps=\"http://schemas.microsoft.com/office/word/2010/wordprocessingShape\" xmlns:wpg=\"http://schemas.microsoft.com/office/word/2010/wordprocessingGroup\" xmlns:w14=\"http://schemas.microsoft.com/office/word/2010/wordml\" xmlns:w15=\"http://schemas.microsoft.com/office/word/2012/wordml\" xmlns:w16=\"http://schemas.microsoft.com/office/word/2018/wordml\" xmlns:w16cex=\"http://schemas.microsoft.com/office/word/2018/wordml/cex\" xmlns:w16cid=\"http://schemas.microsoft.com/office/word/2016/wordml/cid\" xmlns=\"http://schemas.microsoft.com/office/tasks/2019/documenttasks\" xmlns:cr=\"http://schemas.microsoft.com/office/comments/2020/reactions\"><w:body><w:p><w:pPr><w:pStyle w:val=\"Title\"/><w:spacing w:before=\"120\" w:after=\"120\"/><w:ind w:right=\"-41\"/><w:jc w:val=\"center\"/><\/w:pPr><w:r><w:rPr><w:sz w:val=\"24\"/><w:szCs w:val=\"24\"/><\/w:rPr><w:t xml:space=\"preserve\">DECLARAÇÃO DE HIPOSSUFICIÊNCIA ECONÔMICA<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"140\" w:line=\"264\" w:lineRule=\"auto\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">{{D_NOME}}<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">{{D_QUALIF}}<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">, <\/w:t><\/w:r><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">DECLARA<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">, sob as penas da lei, para fins de requerimento da gratuidade da justiça, nos termos do art. 5º, LXXIV, da Constituição Federal e dos arts. 98 e 99 do Código de Processo Civil, que não possui recursos suficientes para pagar as custas, as despesas processuais e os honorários advocatícios sem prejuízo do próprio sustento e do sustento de sua família.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"140\" w:line=\"264\" w:lineRule=\"auto\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">⟦IF:SIT⟧<\/w:t><\/w:r><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">Situação econômica:<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> renda mensal aproximada de <\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">{{RENDA}}<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">; <\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">{{DEPENDENTES}}<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> dependente(s); principais despesas fixas: <\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">{{DESPESAS}}<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"140\" w:line=\"264\" w:lineRule=\"auto\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">Requer que o benefício abranja todas as despesas previstas no art. 98, § 1º, do Código de Processo Civil, em todos os atos do processo e em todas as instâncias, inclusive honorários periciais e de intérprete, depósitos recursais, exames e emolumentos.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"140\" w:line=\"264\" w:lineRule=\"auto\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">Esta declaração goza de presunção de veracidade (art. 99, § 3º, do CPC), e a assistência por advogado particular não impede a concessão do benefício (art. 99, § 4º, do CPC). Conforme a tese fixada pelo Superior Tribunal de Justiça no <\/w:t><\/w:r><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">Tema Repetitivo 1178<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> (REsps 1.988.686/RJ, 1.988.687/RJ e 1.988.697/RJ, acórdão publicado em 18/03/2026): (i) é vedado o uso de critérios objetivos para o indeferimento imediato da gratuidade requerida por pessoa natural; (ii) havendo nos autos elementos aptos a afastar a presunção de hipossuficiência, o juiz deverá determinar ao requerente a comprovação de sua condição, indicando de modo preciso as razões que justificam tal afastamento, nos termos do art. 99, § 2º, do CPC; e (iii) cumprida a diligência, parâmetros objetivos só podem ser adotados em caráter suplementar, nunca como fundamento exclusivo do indeferimento.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"140\" w:line=\"264\" w:lineRule=\"auto\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">O(A) declarante compromete-se a apresentar os documentos solicitados e declara-se ciente de que a falsidade desta declaração o(a) sujeita à revogação do benefício, ao pagamento das despesas e, em caso de má-fé, a multa de até o décuplo de seu valor (art. 100, parágrafo único, do CPC), sem prejuízo das sanções penais cabíveis (art. 299 do Código Penal).<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:keepNext/><w:spacing w:before=\"60\" w:after=\"0\"/><w:ind w:right=\"-41\"/><w:jc w:val=\"center\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">Belo Horizonte/MG, <\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">{{DATA}}<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:keepNext/><w:spacing w:before=\"440\" w:after=\"0\"/><w:ind w:right=\"-41\"/><w:jc w:val=\"center\"/><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">______________________________________________<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:keepNext/><w:spacing w:after=\"0\"/><w:ind w:right=\"-41\"/><w:jc w:val=\"center\"/><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"20\"/><w:szCs w:val=\"20\"/><\/w:rPr><w:t xml:space=\"preserve\">{{D_NOMEU}}<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:keepNext/><w:spacing w:after=\"0\"/><w:ind w:right=\"-41\"/><w:jc w:val=\"center\"/><\/w:pPr><w:r><w:rPr><w:sz w:val=\"20\"/><w:szCs w:val=\"20\"/><\/w:rPr><w:t xml:space=\"preserve\">CPF: <\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"20\"/><w:szCs w:val=\"20\"/><\/w:rPr><w:t xml:space=\"preserve\">{{D_CPF}}<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"0\"/><w:ind w:right=\"-41\"/><w:jc w:val=\"center\"/><\/w:pPr><w:r><w:rPr><w:sz w:val=\"20\"/><w:szCs w:val=\"20\"/><\/w:rPr><w:t xml:space=\"preserve\">DECLARANTE<\/w:t><\/w:r><\/w:p><w:sectPr><w:headerReference r:id=\"rId9\" w:type=\"default\"/><w:footerReference r:id=\"rId10\" w:type=\"default\"/><w:pgSz w:h=\"16838\" w:w=\"11906\" w:orient=\"portrait\"/><w:pgMar w:bottom=\"1440\" w:top=\"1440\" w:left=\"1440\" w:right=\"1440\" w:header=\"0\" w:footer=\"0\" w:gutter=\"0\"/><w:pgNumType w:start=\"1\"/><\/w:sectPr><\/w:body><\/w:document>"};
var BASE_DOCX = "";
</script>
<script>
(function(){
  var SAVE_KEY = 'ab-docs-escritorio';
  var BLANK = DocEngine.BLANK;
  function today(){ var d=new Date(); return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'); }
  function freshState(){
    return {
      contrato:'exito', gerarProc:true, gerarDecl:false,
      socReg:'', plataforma:'', advs:[],
      cts:[newCt()],
      objServico:'', parte:'', objResultado:'', extensao:'o trânsito em julgado, o cumprimento de sentença e o efetivo recebimento dos valores', exclusao:'',
      atuacao:'ajuizamento', objAcao:'', processo:'', juizo:'', f2Trib:'Tribunal de Justiça do Estado de Minas Gerais', f3Trib:'Superior Tribunal de Justiça e/ou Supremo Tribunal Federal', agravo:'f1', cumpr:'incluso', cumprValor:'',
      finalidade:'',
      pct:'30', rec:false, recPct:'40', recTrib:'Superior Tribunal de Justiça e/ou Supremo Tribunal Federal', per:false, perParc:'12', fazer:'', minimo:'', multa:'10',
      iniTotal:'', iniPeca:'petição inicial', abate:'nao', atoPrincipal:'protocolada a petição inicial',
      f1:'', f2:'', f3:'', f23Parc:'1',
      parcelas:[], inicio:'entrada', prazoCritico:'não há prazo crítico identificado', solid:'solidario',
      cliBanco:'', cliAg:'', cliConta:'', cliPix:'',
      declarante:0, sit:true, renda:'', dependentes:'', despesas:'',
      data: today(), T1_NOME:'', T1_CPF:'', T2_NOME:'', T2_CPF:''
    };
  }
  function newCt(){ return {tipo:'pf', gen:'', nome:'', nac:'brasileiro(a)', ec:'', prof:'', rg:'', cpf:'', end:'', cep:'', email:'', tel:'', rep:'', razao:'', cnpj:'', repNome:'', repCargo:'', repCpf:'', repDoc:'contrato social'}; }
  function newAdv(){ return {trat:'Dr.', nome:'', uf:'MG', oab:'', end:'', email:''}; }

  var st = freshState();
  var cfgTimer=null;
  function persist(){ clearTimeout(cfgTimer); cfgTimer=setTimeout(saveConfig, 900); }

  // ---------- máscaras
  function digits(s){ return (s||'').replace(/\D/g,''); }
  var MASKS = {
    cpf:function(v){ var d=digits(v).slice(0,11); return d.replace(/(\d{3})(\d)/,'$1.$2').replace(/(\d{3})(\d)/,'$1.$2').replace(/(\d{3})(\d{1,2})$/,'$1-$2'); },
    cnpj:function(v){ var d=digits(v).slice(0,14); return d.replace(/^(\d{2})(\d)/,'$1.$2').replace(/^(\d{2})\.(\d{3})(\d)/,'$1.$2.$3').replace(/\.(\d{3})(\d)/,'.$1/$2').replace(/(\d{4})(\d)/,'$1-$2'); },
    cep:function(v){ var d=digits(v).slice(0,8); return d.replace(/^(\d{2})(\d{3})(\d)/,'$1.$2-$3').replace(/^(\d{2})(\d)/,'$1.$2'); },
    tel:function(v){ var d=digits(v).slice(0,11); if(d.length<=10) return d.replace(/^(\d{2})(\d)/,'($1) $2').replace(/(\d{4})(\d)/,'$1-$2'); return d.replace(/^(\d{2})(\d{5})(\d)/,'($1) $2-$3'); }
  };
  function fmtMoneyInput(v){ var n=Compose.parseMoney(v); return n==null?'':Compose.moedaCurta(n).replace('R$ ',''); }

  // ---------- visibilidade
  function vis(){
    var t = st.contrato, temContrato = t!=='nenhum';
    var cond = {
      contrato: temContrato, caso: temContrato || st.gerarProc, obj12: t==='exito'||t==='inicial'||(t==='nenhum'&&st.gerarProc), obj3: t==='fixo',
      procOnly: st.gerarProc, honorarios: temContrato, t1: t==='exito', t2: t==='inicial', t3: t==='fixo', exitoAny: t==='exito'||t==='inicial',
      rec: st.rec, per: st.per, pagamento: t==='inicial'||t==='fixo', multiParc: st.parcelas.length>1, decl: st.gerarDecl, sit: st.sit,
      multiCt: st.cts.length>1, cumprProprio: t==='fixo' && st.cumpr==='proprio'
    };
    document.querySelectorAll('[data-show]').forEach(function(el){ el.hidden = !cond[el.dataset.show]; });
    document.getElementById('pagLegend').textContent = t==='fixo' ? 'Pagamento da Fase 1' : 'Pagamento da entrada';
    if (t==='nenhum' && st.gerarProc) {
      document.querySelectorAll('[data-show="obj12"] [data-k="objResultado"],[data-show="obj12"] [data-k="extensao"],[data-show="obj12"] [data-k="exclusao"]').forEach(function(i){ i.closest('label').hidden = true; });
    } else {
      document.querySelectorAll('[data-show="obj12"] label').forEach(function(l){ l.hidden=false; });
    }
  }

  // ---------- ligação de campos simples
  function bindSimple(root){
    root.querySelectorAll('[data-k]').forEach(function(el){
      var k = el.dataset.k;
      if (el.type==='checkbox') el.checked = !!st[k];
      else el.value = st[k] == null ? '' : st[k];
      el.addEventListener(el.type==='checkbox'||el.tagName==='SELECT' ? 'change' : 'input', function(){
        if (el.dataset.mask) el.value = MASKS[el.dataset.mask](el.value);
        st[k] = el.type==='checkbox' ? el.checked : el.value;
        if (el.dataset.save) persist();
        update();
      });
      if (el.dataset.money) el.addEventListener('blur', function(){ el.value = fmtMoneyInput(el.value); st[k]=el.value; update(); });
    });
  }
  document.querySelectorAll('input[name=contrato]').forEach(function(r){
    r.checked = r.value===st.contrato;
    r.addEventListener('change', function(){
      st.contrato = r.value;
      if (r.value==='inicial' && st.pct==='30') st.pct='20';
      if (r.value==='exito' && st.pct==='20') st.pct='30';
      if (r.value==='inicial' && st.recPct==='40') st.recPct='30';
      if (r.value==='exito' && st.recPct==='30') st.recPct='40';
      syncInputs(); update();
    });
  });
  function syncInputs(){
    document.querySelectorAll('input[name=contrato]').forEach(function(r){ r.checked = r.value===st.contrato; });
    document.querySelectorAll('#form > fieldset [data-k]').forEach(function(el){
      if (el.closest('#cts') || el.closest('#advs')) return;
      var k=el.dataset.k; if (el.type==='checkbox') el.checked=!!st[k]; else if (document.activeElement!==el) el.value = st[k]==null?'':st[k];
    });
  }

  // ---------- pessoas
  function field(label, key, obj, opts){
    opts = opts||{};
    var l=document.createElement('label'); l.className='f'+(opts.full?' full':'');
    l.appendChild(document.createTextNode(label));
    var el;
    if (opts.select){ el=document.createElement('select'); opts.select.forEach(function(o){ var op=document.createElement('option'); op.value=o[0]; op.textContent=o[1]; el.appendChild(op); }); }
    else { el=document.createElement('input'); el.type='text'; if(opts.ph) el.placeholder=opts.ph; if(opts.inputmode) el.inputMode=opts.inputmode; }
    el.value = obj[key]||'';
    if (opts.optional) el.dataset.optional='1';
    el.addEventListener(opts.select?'change':'input', function(){
      if (opts.mask) el.value = MASKS[opts.mask](el.value);
      obj[key]=el.value; if (opts.onchange) opts.onchange(); update();
    });
    l.appendChild(el); return l;
  }
  function renderCts(){
    var box=document.getElementById('cts'); box.innerHTML='';
    st.cts.forEach(function(c,i){
      var card=document.createElement('div'); card.className='person';
      var h=document.createElement('div'); h.className='person-h';
      var t=document.createElement('strong'); t.textContent = st.cts.length>1 ? 'Contratante '+(i+1) : 'Contratante'; h.appendChild(t);
      var seg=document.createElement('div'); seg.className='seg'; seg.setAttribute('role','group'); seg.setAttribute('aria-label','Tipo de pessoa');
      [['pf','Pessoa física'],['pj','Pessoa jurídica']].forEach(function(o){ var b=document.createElement('button'); b.type='button'; b.textContent=o[1]; b.setAttribute('aria-pressed', c.tipo===o[0]); b.onclick=function(){ c.tipo=o[0]; renderCts(); update(); }; seg.appendChild(b); });
      h.appendChild(seg);
      if (st.cts.length>1){ var rm=document.createElement('button'); rm.className='link'; rm.type='button'; rm.textContent='Remover'; rm.onclick=function(){ st.cts.splice(i,1); renderCts(); update(); }; h.appendChild(rm); }
      card.appendChild(h);
      var g=document.createElement('div'); g.className='grid';
      if (c.tipo==='pj'){
        g.appendChild(field('Razão social','razao',c,{full:true}));
        g.appendChild(field('CNPJ','cnpj',c,{mask:'cnpj',inputmode:'numeric'}));
        g.appendChild(field('E-mail','email',c));
        g.appendChild(field('Endereço da sede','end',c,{full:true,ph:'logradouro, número, complemento, bairro, cidade/UF'}));
        g.appendChild(field('CEP','cep',c,{mask:'cep',inputmode:'numeric'}));
        g.appendChild(field('Telefone/WhatsApp','tel',c,{mask:'tel',inputmode:'tel'}));
        g.appendChild(field('Representante legal','repNome',c));
        g.appendChild(field('Cargo','repCargo',c,{ph:'ex.: sócio administrador'}));
        g.appendChild(field('CPF do representante','repCpf',c,{mask:'cpf',inputmode:'numeric'}));
        g.appendChild(field('Representação conforme','repDoc',c));
      } else {
        g.appendChild(field('Nome completo','nome',c,{full:true, onchange:renderDeclSel}));
        g.appendChild(field('Tratamento no texto','gen',c,{select:[['','Neutro: portador(a), inscrito(a)'],['f','Feminino'],['m','Masculino']]}));
        g.appendChild(field('Nacionalidade','nac',c));
        g.appendChild(field('Estado civil','ec',c,{ph:'ex.: solteira'}));
        g.appendChild(field('Profissão','prof',c));
        g.appendChild(field('RG e órgão emissor','rg',c,{ph:'ex.: MG-12.345.678 SSP/MG'}));
        g.appendChild(field('CPF','cpf',c,{mask:'cpf',inputmode:'numeric'}));
        g.appendChild(field('Endereço','end',c,{full:true,ph:'logradouro, número, complemento, bairro, cidade/UF'}));
        g.appendChild(field('CEP','cep',c,{mask:'cep',inputmode:'numeric'}));
        g.appendChild(field('Telefone/WhatsApp','tel',c,{mask:'tel',inputmode:'tel'}));
        g.appendChild(field('E-mail','email',c));
        g.appendChild(field('Representante, se menor ou incapaz (opcional)','rep',c,{full:true,optional:true,ph:'nome completo, qualificação, CPF, na qualidade de genitor(a)/curador(a)'}));
      }
      card.appendChild(g); box.appendChild(card);
    });
    renderDeclSel(); markEmpty();
  }
  function renderAdvs(){
    var box=document.getElementById('advs'); box.innerHTML='';
    st.advs.forEach(function(a,i){
      var card=document.createElement('div'); card.className='person';
      var h=document.createElement('div'); h.className='person-h';
      var t=document.createElement('strong'); t.textContent='Advogado(a) '+(i+2); h.appendChild(t);
      var rm=document.createElement('button'); rm.className='link'; rm.type='button'; rm.textContent='Remover'; rm.onclick=function(){ st.advs.splice(i,1); persist(); renderAdvs(); update(); }; h.appendChild(rm);
      card.appendChild(h);
      var g=document.createElement('div'); g.className='grid';
      var save=function(){ persist(); };
      g.appendChild(field('Tratamento','trat',a,{select:[['Dr.','Dr.'],['Dra.','Dra.']],onchange:save}));
      g.appendChild(field('Nome completo','nome',a,{onchange:save}));
      g.appendChild(field('OAB – UF','uf',a,{onchange:save}));
      g.appendChild(field('OAB – número','oab',a,{onchange:save}));
      g.appendChild(field('Endereço profissional','end',a,{full:true,onchange:save}));
      g.appendChild(field('E-mail','email',a,{onchange:save}));
      card.appendChild(g); box.appendChild(card);
    });
    markEmpty();
  }
  function renderDeclSel(){
    var sel=document.getElementById('declSel'); var cur=st.declarante; sel.innerHTML='';
    st.cts.forEach(function(c,i){ if(c.tipo==='pj') return; var o=document.createElement('option'); o.value=i; o.textContent=(c.nome||'Contratante '+(i+1)); sel.appendChild(o); });
    if (!sel.options.length){ var o=document.createElement('option'); o.textContent='Cadastre um cliente pessoa física'; o.value=''; sel.appendChild(o); }
    sel.value = String(cur); if (sel.selectedIndex<0) sel.selectedIndex=0;
    st.declarante = parseInt(sel.value,10)||0;
  }
  document.getElementById('declSel').addEventListener('change',function(e){ st.declarante=parseInt(e.target.value,10)||0; update(); });
  document.getElementById('addCt').onclick=function(){ st.cts.push(newCt()); renderCts(); update(); };
  document.getElementById('addAdv').onclick=function(){ st.advs.push(newAdv()); persist(); renderAdvs(); update(); };

  // ---------- parcelas
  function renderParc(){
    var tb=document.querySelector('#parcTbl tbody'); tb.innerHTML='';
    st.parcelas.forEach(function(p,i){
      var tr=document.createElement('tr');
      var td0=document.createElement('td'); td0.textContent = i===0 ? (st.parcelas.length>1?'Entrada (1ª)':'Única') : (i+1)+'ª'; tr.appendChild(td0);
      var td1=document.createElement('td'); var d=document.createElement('input'); d.type='date'; d.value=p.data||''; d.setAttribute('aria-label','Vencimento da parcela '+(i+1)); d.oninput=function(){ p.data=d.value; update(); }; td1.appendChild(d); tr.appendChild(td1);
      var td2=document.createElement('td'); var v=document.createElement('input'); v.type='text'; v.value=p.valor||''; v.setAttribute('aria-label','Valor da parcela '+(i+1)); v.oninput=function(){ p.valor=v.value; update(); }; v.onblur=function(){ v.value=fmtMoneyInput(v.value); p.valor=v.value; update(); }; td2.appendChild(v); tr.appendChild(td2);
      var td3=document.createElement('td'); var s=document.createElement('select'); s.setAttribute('aria-label','Forma da parcela '+(i+1)); ['PIX','Cartão de crédito','PIX ou cartão'].forEach(function(o){ var op=document.createElement('option'); op.textContent=o; s.appendChild(op); }); s.value=p.forma||'PIX'; s.onchange=function(){ p.forma=s.value; update(); }; td3.appendChild(s); tr.appendChild(td3);
      var td4=document.createElement('td'); var rm=document.createElement('button'); rm.type='button'; rm.className='link'; rm.textContent='Remover'; rm.onclick=function(){ st.parcelas.splice(i,1); renderParc(); update(); }; td4.appendChild(rm); tr.appendChild(td4);
      tb.appendChild(tr);
    });
    markEmpty();
  }
  function addMonths(iso,n){ if(!iso) return ''; var p=iso.split('-').map(Number); var d=new Date(p[0],p[1]-1+n,1); var last=new Date(d.getFullYear(),d.getMonth()+1,0).getDate(); d.setDate(Math.min(p[2],last)); return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'); }
  document.getElementById('genBtn').onclick=function(){
    var total=Compose.parseMoney(document.getElementById('genTotal').value);
    var n=Math.max(1,Math.min(36,parseInt(document.getElementById('genN').value,10)||1));
    var d0=document.getElementById('genData').value, forma=document.getElementById('genForma').value;
    if (total==null){ say('Informe o total para gerar as parcelas.', true); document.getElementById('genTotal').focus(); return; }
    var cents=Math.round(total*100), base=Math.floor(cents/n), resto=cents-base*n;
    st.parcelas=[]; for(var i=0;i<n;i++){ var c=base+(i===0?resto:0); st.parcelas.push({data:addMonths(d0,i), valor:fmtMoneyInput((c/100).toFixed(2).replace('.',',')), forma:forma}); }
    if (st.contrato==='inicial' && !st.iniTotal){ st.iniTotal=fmtMoneyInput(String(total).replace('.',',')); syncInputs(); }
    if (st.contrato==='fixo' && !st.f1){ st.f1=fmtMoneyInput(String(total).replace('.',',')); syncInputs(); }
    renderParc(); update(); say('');
  };
  document.getElementById('addParc').onclick=function(){ var last=st.parcelas[st.parcelas.length-1]; st.parcelas.push({data:last?addMonths(last.data,1):'', valor:'', forma:last?last.forma:'PIX'}); renderParc(); update(); };

  // ---------- documentos
  var DOCS = {
    exito:{tpl:'t_content1', nome:'Contrato de honorários', file:'Contrato de Honorarios (exito)'},
    inicial:{tpl:'t_content2', nome:'Contrato de honorários', file:'Contrato de Honorarios (entrada e exito)'},
    fixo:{tpl:'t_content3', nome:'Contrato de honorários', file:'Contrato de Honorarios (fixo por instancia)'},
    proc:{tpl:'t_content_proc', nome:'Procuração', file:'Procuracao'},
    decl:{tpl:'t_content_decl', nome:'Declaração de hipossuficiência', file:'Declaracao de Hipossuficiencia'}
  };
  var TOKENS = {}; Object.keys(TEMPLATES).forEach(function(k){ TOKENS[k]=DocEngine.tokensIn(TEMPLATES[k]); });
  function selectedDocs(){
    var out=[]; if (st.contrato!=='nenhum') out.push(st.contrato); if (st.gerarProc) out.push('proc'); if (st.gerarDecl) out.push('decl'); return out;
  }
  function clientName(){ var c=st.cts[0]; if(!c) return ''; return (c.tipo==='pj'?c.razao:c.nome)||''; }
  function compute(){ return Compose.compose(st); }
  var lastRes=null;
  function renderDocs(){
    var res = lastRes = compute();
    var box=document.getElementById('docs'); box.innerHTML='';
    var nm=clientName(); document.getElementById('who').textContent = nm ? nm + (st.cts.length>1 ? ' e outros' : '') : 'Nenhum cliente informado ainda';
    var sel=selectedDocs();
    document.getElementById('foot').hidden = sel.length<2;
    if (!sel.length){ var e=document.createElement('p'); e.className='empty-folder'; e.textContent='Escolha ao menos um documento na primeira seção.'; box.appendChild(e); }
    sel.forEach(function(k){
      var d=DOCS[k], miss=Compose.missingFor(TOKENS[d.tpl], res);
      var wrap=document.createElement('div'); wrap.className='doc';
      var h=document.createElement('div'); h.className='doc-h';
      var n=document.createElement('span'); n.className='doc-name'; n.textContent=d.nome; h.appendChild(n);
      var s=document.createElement('span'); s.className='state '+(miss.length?'pend':'ok'); s.textContent = miss.length ? (miss.length===1?'1 campo em branco':miss.length+' campos em branco') : 'Completo'; h.appendChild(s);
      wrap.appendChild(h);
      if (miss.length){ var ch=document.createElement('div'); ch.className='chips'; miss.slice(0,14).forEach(function(m){ var c=document.createElement('span'); c.className='chip'; c.textContent=m; ch.appendChild(c); }); if(miss.length>14){ var c2=document.createElement('span'); c2.className='chip'; c2.textContent='+'+(miss.length-14); ch.appendChild(c2);} wrap.appendChild(ch); }
      var b=document.createElement('button'); b.className='btn'+(miss.length?' ghost':''); b.type='button'; b.textContent='Baixar '+d.nome.toLowerCase(); b.onclick=function(){ downloadOne(k); }; wrap.appendChild(b);
      box.appendChild(wrap);
    });
    // soma das parcelas
    var sl=document.getElementById('sumLine');
    if (st.parcelas.length){
      var tot = st.contrato==='fixo' ? Compose.parseMoney(st.f1) : Compose.parseMoney(st.iniTotal);
      var soma=res.somaParcelas;
      if (tot!=null && Math.abs(tot-soma)>0.004){ sl.className='sumline bad'; sl.textContent='As parcelas somam '+Compose.moedaCurta(soma)+', mas o total informado é '+Compose.moedaCurta(tot)+'. Ajuste antes de baixar.'; }
      else { sl.className='sumline'; sl.textContent='Soma das parcelas: '+Compose.moedaCurta(soma)+'.'; }
    } else { sl.className='sumline'; sl.textContent='Nenhuma parcela gerada ainda.'; }
    // sugestão de finalidade
    var fin=document.getElementById('finalidade');
    var auto = res.values.FINALIDADE && res.values.FINALIDADE!==BLANK ? res.values.FINALIDADE : '';
    fin.placeholder = auto && !st.finalidade ? auto : 'ex.: ajuizar ação de indenização em face de …';
  }
  function markEmpty(){
    document.querySelectorAll('#form input[type=text], #form textarea').forEach(function(el){
      if (el.dataset.optional || el.id==='genTotal' || el.id==='genN') { el.classList.remove('empty'); return; }
      var hiddenAnc = el.closest('[hidden]'); el.classList.toggle('empty', !hiddenAnc && !el.value.trim());
    });
  }
  var timer=null;
  var quiet=false;
  function update(){ vis(); markEmpty(); clearTimeout(timer); timer=setTimeout(renderDocs,120); if(!quiet) markDirty(); }

  // ---------- geração e download
  var baseBytes=null;
  function baseZipBytes(){ if(!baseBytes){ var bin=atob(BASE_DOCX); var u=new Uint8Array(bin.length); for(var i=0;i<bin.length;i++) u[i]=bin.charCodeAt(i); baseBytes=u; } return baseBytes; }
  function fileSafe(s){ return (s||'Cliente').normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^\w\s().-]/g,'').replace(/\s+/g,' ').trim().slice(0,60) || 'Cliente'; }
  async function buildDocx(k){
    var res = compute(), d=DOCS[k];
    var xml = DocEngine.fill(TEMPLATES[d.tpl], res, DOMParser, XMLSerializer);
    var zip = await JSZip.loadAsync(baseZipBytes());
    zip.file('word/document.xml', xml);
    return {name: d.file+' - '+fileSafe(clientName())+'.docx', blob: await zip.generateAsync({type:'blob', compression:'DEFLATE'})};
  }
  var dlPromise=null;
  function getDownloads(){ if(!dlPromise){ dlPromise = (window.claude && window.claude.use) ? Promise.race([window.claude.use('downloads'), new Promise(function(r){ setTimeout(function(){ r(null); }, 3000); })]) : Promise.resolve(null); } return dlPromise; }
  function say(t, err){ var m=document.getElementById('msg'); m.textContent=t||''; m.className='msg'+(err?' err':''); }
  async function save(name, blob){
    var dl = await getDownloads();
    if (!dl){
      var url=URL.createObjectURL(blob), a=document.createElement('a');
      a.href=url; a.download=name; document.body.appendChild(a); a.click(); a.remove();
      setTimeout(function(){ URL.revokeObjectURL(url); }, 4000);
      say(name+' baixado.'); return;
    }
    try { await dl.save({filename:name, data:blob}); say(name+' salvo.'); }
    catch(e){
      var c=e&&e.code;
      if (c==='declined') say('Download cancelado.');
      else if (c==='rate_limited') say('Já há um download aguardando confirmação. Conclua-o e tente de novo.', true);
      else say('Não foi possível salvar o arquivo ('+(c||'erro')+').', true);
    }
  }
  async function downloadOne(k){
    try { await saveCase(true); say('Gerando '+DOCS[k].nome.toLowerCase()+'…'); var f=await buildDocx(k); await save(f.name,f.blob); }
    catch(e){ say('Erro ao gerar o documento: '+(e&&e.message||e), true); }
  }
  document.getElementById('dlAll').onclick=async function(){
    try{
      await saveCase(true);
      say('Gerando os documentos…');
      var zip=new JSZip(); var sel=selectedDocs();
      for (var i=0;i<sel.length;i++){ var f=await buildDocx(sel[i]); zip.file(f.name, f.blob); }
      var blob=await zip.generateAsync({type:'blob'});
      await save('Documentos - '+fileSafe(clientName())+'.zip', blob);
    } catch(e){ say('Erro ao gerar os documentos: '+(e&&e.message||e), true); }
  };


  // ---------- tema
  var themeBtn=document.getElementById('themeBtn');
  function isDark(){ var a=document.documentElement.getAttribute('data-theme'); if(a) return a==='dark'; return window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches; }
  function paintTheme(){ themeBtn.textContent = isDark() ? 'Tema claro' : 'Tema escuro'; }
  themeBtn.onclick=function(){ document.documentElement.setAttribute('data-theme', isDark()?'light':'dark'); paintTheme(); };
  paintTheme();

  bindSimple(document.getElementById('form'));
  document.getElementById('genData').value = today();
  quiet=true; renderCts(); renderAdvs(); renderParc(); update(); quiet=false;
  getDownloads();

  // ================== LOGIN E BANCO DE DADOS (Supabase) ==================
  var $ = function(id){ return document.getElementById(id); };
  var SB_LIB = window.__SB_TEST__ || window.supabase;
  var configured = /^https:\/\/[a-z0-9-]+\.supabase\.co\/?$/i.test(SUPABASE_URL) && SUPABASE_ANON_KEY && SUPABASE_ANON_KEY.length > 30;
  var sb = configured ? SB_LIB.createClient(SUPABASE_URL.replace(/\/$/, ''), SUPABASE_ANON_KEY) : null;
  var currentId = null, dirty = false, me = null, saving = false;

  function show(id, on){ $(id).hidden = !on; }
  function authMsg(t, err){ var m=$('authMsg'); m.textContent=t||''; m.className='msg'+(err?' err':''); }
  function caseMsg(t, err){ var m=$('caseMsg'); m.textContent=t||''; m.className='msg'+(err?' err':''); }
  function fmtDate(iso){ try { var d=new Date(iso); return d.toLocaleDateString('pt-BR')+' às '+d.toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'}); } catch(e){ return ''; } }
  var TIPO_NOME = {exito:'Só êxito', inicial:'Entrada + êxito', fixo:'Fixo por instância', nenhum:'Sem contrato'};

  function paintCur(){
    var el=$('curCase'), nm=clientName();
    if (!currentId){ el.textContent = dirty ? 'Novo cliente com alterações não salvas' : 'Novo cliente, ainda não salvo'; }
    else { el.textContent = (nm||'Cliente sem nome') + (dirty ? ' · alterações não salvas' : ' · salvo'); }
    el.classList.toggle('dirty', dirty);
  }
  var markDirty = function(){ if (!dirty){ dirty=true; } paintCur(); };

  function showApp(on){
    show('auth', !on); show('app', on);
    show('userEmail', on); show('logoutBtn', on);
    if (on) $('userEmail').textContent = me && me.email || '';
  }
  function showCard(which){
    ['setupCard','loginForm','newPassForm'].forEach(function(id){ show(id, id===which); });
  }

  // ---------- configurações do escritório
  async function loadConfig(){
    var r = await sb.from('config').select('dados').eq('id', 1).maybeSingle();
    if (r.error || !r.data) return;
    var d = r.data.dados || {};
    quiet = true;
    if (d.socReg != null) st.socReg = d.socReg;
    if (d.plataforma != null) st.plataforma = d.plataforma;
    if (Array.isArray(d.advs)) st.advs = d.advs;
    syncInputs(); renderAdvs(); update();
    quiet = false;
  }
  var saveConfig = async function(){
    if (!sb || !me) return;
    var r = await sb.from('config').update({dados:{socReg:st.socReg, plataforma:st.plataforma, advs:st.advs}}).eq('id', 1);
    if (r.error) caseMsg('Não foi possível salvar as configurações do escritório: '+r.error.message, true);
  };

  // ---------- clientes
  function snapshot(){ return JSON.parse(JSON.stringify(st)); }
  function docOf(){ var c=st.cts[0]||{}; return (c.tipo==='pj'?c.cnpj:c.cpf)||''; }
  var saveCase = async function(silent){
    if (!sb || !me || saving) return;
    if (silent && !dirty && currentId) return;
    if (!clientName().trim()){
      if (!silent) caseMsg('Informe o nome do cliente antes de salvar.', true);
      return;
    }
    saving = true;
    var doc = docOf();
    var row = {cliente: clientName().trim(), documento: doc, doc_digitos: digits(doc), tipo_contrato: st.contrato, dados: snapshot()};
    try {
      var r = currentId
        ? await sb.from('casos').update(row).eq('id', currentId).select('id, atualizado_em').single()
        : await sb.from('casos').insert(row).select('id, atualizado_em').single();
      if (r.error) throw r.error;
      currentId = r.data.id; dirty = false; paintCur();
      caseMsg('Salvo em '+fmtDate(r.data.atualizado_em)+'.');
      searchCases();
    } catch(e){
      caseMsg('Não foi possível salvar: '+(e.message||e)+'. Os dados continuam na tela.', true);
    } finally { saving = false; }
  };
  async function openCase(id){
    if (dirty && !confirm('Há alterações não salvas neste cliente. Abrir outro mesmo assim?')) return;
    caseMsg('Abrindo…');
    var r = await sb.from('casos').select('id, dados').eq('id', id).single();
    if (r.error){ caseMsg('Não foi possível abrir: '+r.error.message, true); return; }
    quiet = true;
    var office = {socReg:st.socReg, plataforma:st.plataforma};
    st = Object.assign(freshState(), r.data.dados || {}, office);
    if (!Array.isArray(st.cts) || !st.cts.length) st.cts=[newCt()];
    currentId = r.data.id; dirty = false;
    syncInputs(); renderCts(); renderAdvs(); renderParc(); update();
    quiet = false; paintCur(); caseMsg(''); searchCases();
    window.scrollTo({top:0, behavior:'smooth'});
  }
  function newCase(){
    if (dirty && !confirm('Há alterações não salvas. Começar um novo cliente mesmo assim?')) return;
    quiet = true;
    var keep = {socReg:st.socReg, plataforma:st.plataforma, advs:st.advs, contrato:st.contrato, gerarProc:st.gerarProc, gerarDecl:st.gerarDecl};
    st = Object.assign(freshState(), keep);
    currentId = null; dirty = false;
    syncInputs(); renderCts(); renderParc(); update();
    quiet = false; paintCur(); caseMsg(''); searchCases();
  }
  async function deleteCase(id, nome){
    if (!confirm('Excluir definitivamente o cadastro de '+(nome||'este cliente')+'? Esta ação não pode ser desfeita.')) return;
    var r = await sb.from('casos').delete().eq('id', id);
    if (r.error){ caseMsg('Não foi possível excluir: '+r.error.message, true); return; }
    if (id === currentId){ currentId = null; dirty = true; paintCur(); }
    caseMsg('Cadastro excluído.'); searchCases();
  }
  var searchTimer=null;
  function searchCases(){ clearTimeout(searchTimer); searchTimer=setTimeout(runSearch, 250); }
  async function runSearch(){
    if (!sb || !me) return;
    var term = ($('caseSearch').value||'').replace(/[,()%*\\]/g,' ').trim();
    var q = sb.from('casos').select('id, cliente, documento, tipo_contrato, atualizado_em').order('atualizado_em', {ascending:false}).limit(30);
    if (term){
      var parts = ['cliente.ilike.%'+term+'%'];
      var dg = digits(term); if (dg.length >= 3) parts.push('doc_digitos.ilike.%'+dg+'%');
      q = q.or(parts.join(','));
    }
    var r = await q;
    var ul = $('caseList'); ul.innerHTML='';
    if (r.error){ caseMsg('Não foi possível carregar os clientes: '+r.error.message, true); return; }
    if (!r.data.length){
      var li=document.createElement('li'); li.className='case-empty';
      li.textContent = term ? 'Nenhum cliente encontrado para essa busca.' : 'Nenhum cliente salvo ainda. Preencha o cadastro abaixo e clique em Salvar.';
      ul.appendChild(li); return;
    }
    r.data.forEach(function(c){
      var li=document.createElement('li'); if (c.id===currentId) li.className='cur';
      var b=document.createElement('button'); b.type='button'; b.className='open';
      var nb=document.createElement('b'); nb.textContent=c.cliente||'Sem nome'; b.appendChild(nb);
      var sm=document.createElement('small'); sm.textContent=[c.documento, TIPO_NOME[c.tipo_contrato]||'', 'atualizado em '+fmtDate(c.atualizado_em)].filter(Boolean).join(' — '); b.appendChild(sm);
      b.onclick=function(){ openCase(c.id); };
      var del=document.createElement('button'); del.type='button'; del.className='link'; del.textContent='Excluir';
      del.setAttribute('aria-label','Excluir '+(c.cliente||'cliente'));
      del.onclick=function(){ deleteCase(c.id, c.cliente); };
      li.appendChild(b); li.appendChild(del); ul.appendChild(li);
    });
  }

  // ---------- sessão
  async function enter(session){
    me = session.user;
    var m = await sb.from('membros').select('user_id').eq('user_id', me.id).maybeSingle();
    if (m.error || !m.data){
      await sb.auth.signOut(); me = null;
      showApp(false); showCard('loginForm');
      authMsg('Seu usuário ainda não foi liberado para este escritório. Peça ao administrador para incluí-lo na tabela de membros.', true);
      return;
    }
    showApp(true); authMsg('');
    await loadConfig(); paintCur(); searchCases();
  }
  function leave(){
    me = null; currentId = null; dirty = false;
    quiet = true; st = freshState(); syncInputs(); renderCts(); renderAdvs(); renderParc(); update(); quiet = false;
    $('caseList').innerHTML=''; showApp(false); showCard('loginForm');
  }

  $('loginForm').addEventListener('submit', async function(e){
    e.preventDefault();
    var email=$('loginEmail').value.trim(), pass=$('loginPass').value;
    $('loginBtn').disabled = true; authMsg('Entrando…');
    var r = await sb.auth.signInWithPassword({email:email, password:pass});
    $('loginBtn').disabled = false;
    if (r.error){ authMsg(/invalid/i.test(r.error.message) ? 'E-mail ou senha incorretos.' : 'Não foi possível entrar: '+r.error.message, true); return; }
    $('loginPass').value='';
    enter(r.data.session);
  });
  $('forgotBtn').onclick = async function(){
    var email=$('loginEmail').value.trim();
    if (!email){ authMsg('Digite seu e-mail no campo acima e clique de novo em “Esqueci minha senha”.', true); $('loginEmail').focus(); return; }
    var r = await sb.auth.resetPasswordForEmail(email, {redirectTo: location.origin + location.pathname});
    authMsg(r.error ? 'Não foi possível enviar: '+r.error.message : 'Se o e-mail estiver cadastrado, você receberá um link para criar uma nova senha.', !!r.error);
  };
  $('newPassForm').addEventListener('submit', async function(e){
    e.preventDefault();
    var a=$('newPass').value, b=$('newPass2').value, m=$('newPassMsg');
    if (a.length<8 || a!==b){ m.textContent = a!==b ? 'As senhas não conferem.' : 'Use ao menos 8 caracteres.'; m.className='msg err'; return; }
    var r = await sb.auth.updateUser({password:a});
    if (r.error){ m.textContent='Não foi possível salvar: '+r.error.message; m.className='msg err'; return; }
    m.textContent=''; $('newPass').value=''; $('newPass2').value='';
    var s = await sb.auth.getSession();
    if (s.data.session) enter(s.data.session); else { showCard('loginForm'); authMsg('Senha alterada. Entre com a nova senha.'); }
  });
  $('logoutBtn').onclick = async function(){
    if (dirty && !confirm('Há alterações não salvas. Sair mesmo assim?')) return;
    await sb.auth.signOut(); leave();
  };
  $('saveCase').onclick = function(){ saveCase(false); };
  $('newCase').onclick = newCase;
  $('caseSearch').addEventListener('input', searchCases);
  document.addEventListener('keydown', function(e){ if ((e.ctrlKey||e.metaKey) && e.key.toLowerCase()==='s' && me){ e.preventDefault(); saveCase(false); } });
  window.addEventListener('beforeunload', function(e){ if (dirty && me){ e.preventDefault(); e.returnValue=''; } });

  if (!sb){ showApp(false); showCard('setupCard'); }
  else {
    showCard('loginForm');
    var recovering = /type=recovery/.test(location.hash);
    sb.auth.onAuthStateChange(function(event, session){
      if (event === 'PASSWORD_RECOVERY'){ recovering = true; showApp(false); showCard('newPassForm'); }
      if (event === 'SIGNED_OUT') leave();
    });
    sb.auth.getSession().then(function(r){
      var s = r.data && r.data.session;
      if (recovering){ showApp(false); showCard('newPassForm'); return; }
      if (s) enter(s);
    });
  }

})();
</script>
</body>
</html>
