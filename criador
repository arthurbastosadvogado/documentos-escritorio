22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">1.1<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> O presente contrato tem por objeto a prestação de serviços advocatícios pelos CONTRATADOS em favor do(a) CONTRATANTE, consistentes em <\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">{{OBJ_SERVICO}}<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> em face de <\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">{{PARTE_CONTRARIA}}<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">, com o objetivo de <\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">{{OBJ_RESULTADO}}<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">1.2<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> O patrocínio abrange todos os atos necessários à condução da demanda descrita no item 1.1, em qualquer juízo, instância ou tribunal, inclusive a interposição e o acompanhamento de recursos, até <\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">{{EXTENSAO}}<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">, bem como as tratativas extrajudiciais e os requerimentos administrativos a ela diretamente relacionados.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">1.3<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Não estão abrangidos por este contrato, dependendo de novo contrato ou de aditivo escrito, com honorários próprios:<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"80\"/><w:ind w:left=\"567\" w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">a) ações autônomas ou incidentais distintas da descrita no item 1.1, tais como ação rescisória, mandado de segurança, embargos de terceiro, reclamação constitucional e ações conexas;<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"80\"/><w:ind w:left=\"567\" w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">b) defesa em ações propostas pela parte contrária ou por terceiros em autos apartados;<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"80\"/><w:ind w:left=\"567\" w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">c) procedimentos administrativos, criminais, trabalhistas ou de outra natureza não descritos no item 1.1<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">{{EXC_FIM}}<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"80\"/><w:ind w:left=\"567\" w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">⟦IF:EXCLUSAO⟧<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">d) <\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">{{EXCLUSAO}}<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:pStyle w:val=\"Title\"/><w:spacing w:before=\"280\" w:after=\"140\"/><w:ind w:right=\"-41\"/><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">CLÁUSULA SEGUNDA – DAS OBRIGAÇÕES DOS CONTRATADOS<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">2.1<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Os CONTRATADOS obrigam-se a prestar os serviços com zelo, diligência, lealdade e independência técnica, empregando os meios jurídicos cabíveis na defesa dos direitos do(a) CONTRATANTE, em observância ao Estatuto da Advocacia e ao Código de Ética e Disciplina da OAB.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">2.2<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Os CONTRATADOS manterão o(a) CONTRATANTE informado(a) sobre o andamento do processo, prestarão os esclarecimentos solicitados pelos canais oficiais previstos na Cláusula Décima Primeira e o(a) informarão, de forma clara, sobre os riscos da demanda e suas possíveis consequências, inclusive em caso de insucesso.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">2.3<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Os CONTRATADOS prestarão contas ao(à) CONTRATANTE de todos os valores recebidos em seu nome, na forma da Cláusula Quinta.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">2.4<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> A obrigação assumida pelos CONTRATADOS é de meio, e não de resultado. Não há garantia de êxito, de valor ou de prazo, que dependem de fatores alheios à atuação profissional, como as provas disponíveis, a interpretação do Poder Judiciário e a conduta da parte contrária.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">2.5<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Os atos poderão ser praticados por qualquer dos CONTRATADOS ou por advogados integrantes de sua equipe, sem que isso configure infração contratual. Os CONTRATADOS poderão substabelecer os poderes com reserva; o substabelecimento sem reserva de poderes dependerá do prévio e inequívoco conhecimento do(a) CONTRATANTE, nos termos do art. 26, § 1º, do Código de Ética e Disciplina da OAB.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">2.6<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Os CONTRATADOS guardarão sigilo profissional sobre todos os fatos e informações de que tomarem conhecimento em razão deste contrato, dever que subsiste após o seu término.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:pStyle w:val=\"Title\"/><w:spacing w:before=\"280\" w:after=\"140\"/><w:ind w:right=\"-41\"/><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">CLÁUSULA TERCEIRA – DAS OBRIGAÇÕES DO(A) CONTRATANTE<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">3.1<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> O(A) CONTRATANTE obriga-se a:<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"80\"/><w:ind w:left=\"567\" w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">a) fornecer, nos prazos solicitados, os documentos e as informações necessários à condução do caso, responsabilizando-se por sua veracidade, integridade e autenticidade;<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"80\"/><w:ind w:left=\"567\" w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">b) comparecer, quando convocado(a), a audiências, perícias, reuniões e demais atos em que sua presença seja necessária;<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"80\"/><w:ind w:left=\"567\" w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">c) manter atualizados seu endereço, telefone, e-mail e dados bancários, comunicando por escrito qualquer alteração;<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"80\"/><w:ind w:left=\"567\" w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">d) não manter tratativas nem celebrar acordo diretamente com a parte contrária, seus advogados ou prepostos sem a ciência e a participação dos CONTRATADOS, encaminhando-lhes imediatamente qualquer proposta ou contato recebido;<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"80\"/><w:ind w:left=\"567\" w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">e) informar aos CONTRATADOS, no prazo de 48 (quarenta e oito) horas, o recebimento de qualquer valor, bem ou vantagem relacionados ao objeto deste contrato, inclusive quando pago diretamente pela parte contrária;<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"80\"/><w:ind w:left=\"567\" w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">f) custear as despesas previstas na Cláusula Sexta; e<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"80\"/><w:ind w:left=\"567\" w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">g) pagar os honorários na forma e nos prazos ajustados.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">3.2<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Os CONTRATADOS ficam exonerados de responsabilidade pelas consequências decorrentes do descumprimento das obrigações acima que impeça a prática de ato ou o cumprimento de prazo, desde que tenham solicitado previamente a providência ao(à) CONTRATANTE pelos canais oficiais.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:pStyle w:val=\"Title\"/><w:spacing w:before=\"280\" w:after=\"140\"/><w:ind w:right=\"-41\"/><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">CLÁUSULA QUARTA – DOS HONORÁRIOS CONTRATUAIS (EXCLUSIVAMENTE DE ÊXITO)<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">4.1<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Não haverá cobrança de honorários iniciais, de entrada ou de manutenção. Os CONTRATADOS serão remunerados exclusivamente em caso de êxito, assim entendido qualquer proveito econômico obtido pelo(a) CONTRATANTE em razão da demanda, seja por decisão judicial ou administrativa, acordo judicial ou extrajudicial, ou pagamento espontâneo da parte contrária.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">4.2<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Os honorários contratuais correspondem a <\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">{{PCT_TXT}}<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> do valor bruto do proveito econômico obtido pelo(a) CONTRATANTE, percentual aplicável à atuação em primeira instância e nos tribunais de segundo grau. A base de cálculo compreende todas as verbas recebidas, tais como indenizações por danos materiais e morais, restituições, diferenças, parcelas vencidas, multas (astreintes), juros e correção monetária. Os honorários de sucumbência não integram a base de cálculo, pois pertencem aos CONTRATADOS na forma da Cláusula Sétima.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">⟦IF:REC⟧<\/w:t><\/w:r><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">4.3<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Caso a demanda exija a atuação efetiva dos CONTRATADOS perante os Tribunais Superiores (<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">{{REC_TRIB}}<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">), seja na interposição, seja na resposta a recurso especial, recurso extraordinário, recurso de revista ou aos respectivos agravos, o percentual do item 4.2 passará a ser de <\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">{{REC_PCT_TXT}}<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">. A majoração justifica-se pela maior complexidade técnica dessa fase, pelo trabalho adicional exigido e pelo maior tempo de tramitação, durante o qual os CONTRATADOS permanecem sem qualquer remuneração.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">⟦IFNOT:REC⟧<\/w:t><\/w:r><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">4.3<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Não se aplica a este contrato a majoração do percentual em fase recursal perante os Tribunais Superiores.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">⟦IF:REC⟧<\/w:t><\/w:r><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">4.4<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> A majoração prevista no item 4.3:<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">⟦IFNOT:REC⟧<\/w:t><\/w:r><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">4.4<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Item prejudicado, em razão do item 4.3.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"80\"/><w:ind w:left=\"567\" w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">⟦IF:REC⟧<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">a) substitui o percentual do item 4.2, não se somando a ele;<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"80\"/><w:ind w:left=\"567\" w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">⟦IF:REC⟧<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">b) incide sobre o proveito econômico obtido a partir do início da atuação perante os Tribunais Superiores, inclusive por acordo celebrado nessa fase;<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"80\"/><w:ind w:left=\"567\" w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">⟦IF:REC⟧<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">c) não alcança valores já recebidos pelo(a) CONTRATANTE antes dessa fase, como em cumprimento provisório de sentença ou levantamento de parcela incontroversa, sobre os quais permanece o percentual do item 4.2; e<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"80\"/><w:ind w:left=\"567\" w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">⟦IF:REC⟧<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">d) será comunicada por escrito ao(à) CONTRATANTE, pelos canais oficiais, quando da interposição ou da resposta ao recurso.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">4.5<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Em qualquer hipótese, o(a) CONTRATANTE ficará com a <\/w:t><\/w:r><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">maior parte<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> do proveito econômico obtido: os honorários contratuais jamais excederão <\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">{{TETO_TXT}}<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> desse proveito, ficando assegurado ao(à) CONTRATANTE, no mínimo, <\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">{{REST_TXT}}<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> do benefício. Além disso, em observância ao art. 50 do Código de Ética e Disciplina da OAB, os honorários contratuais, somados aos honorários de sucumbência, não poderão superar as vantagens advindas em favor do(a) CONTRATANTE.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">⟦IF:PER⟧<\/w:t><\/w:r><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">4.6<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Tratando-se de prestações periódicas, a base de cálculo compreenderá as parcelas vencidas até a efetiva implantação, acrescidas de <\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">{{PER_PARC}}<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> parcelas vincendas.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">⟦IFNOT:PER⟧<\/w:t><\/w:r><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">4.6<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Não se aplica a este contrato a regra relativa a prestações periódicas.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">4.7<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Quando o proveito consistir, no todo ou em parte, em bens ou direitos, os honorários incidirão sobre o seu valor de mercado na data da decisão ou do acordo. Quando consistir em obrigação de fazer ou de não fazer sem expressão econômica imediata, os honorários serão de <\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">{{FAZER_TXT}}<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">, devidos em até 30 (trinta) dias do efetivo cumprimento da obrigação. Em qualquer caso, os honorários serão pagos em dinheiro.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">4.8<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Em caso de êxito parcial, os honorários incidirão sobre o proveito efetivamente obtido. Em caso de insucesso total, nada será devido a título de honorários contratuais, ressalvadas as hipóteses da Cláusula Oitava e o reembolso das despesas previstas na Cláusula Sexta.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">4.9<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Em caso de acordo, os honorários incidirão sobre o valor total ajustado, observado o percentual aplicável à fase em que o acordo for celebrado. Sendo o acordo parcelado, os honorários serão pagos proporcionalmente, no recebimento de cada parcela. A aceitação de qualquer acordo e de seus termos depende da concordância do(a) CONTRATANTE, devidamente orientado(a) pelos CONTRATADOS.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">4.10<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Os percentuais ajustados foram fixados com moderação, em observância à Tabela de Honorários da OAB/MG e aos critérios do art. 49 do Código de Ética e Disciplina da OAB, considerados a complexidade da causa, o trabalho e o tempo exigidos, a possibilidade de atuação perante os Tribunais Superiores e o risco assumido pelos CONTRATADOS, que somente serão remunerados em caso de êxito.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:pStyle w:val=\"Title\"/><w:spacing w:before=\"280\" w:after=\"140\"/><w:ind w:right=\"-41\"/><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">CLÁUSULA QUINTA – DO PAGAMENTO, DA RETENÇÃO E DA PRESTAÇÃO DE CONTAS<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">5.1<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Quanto aos valores depositados em juízo ou recebidos pelos CONTRATADOS em nome do(a) CONTRATANTE, este(a) autoriza, desde já:<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"80\"/><w:ind w:left=\"567\" w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">a) a juntada deste contrato aos autos e o destaque dos honorários contratuais no alvará, mandado de levantamento, requisição de pequeno valor ou precatório, com pagamento direto aos CONTRATADOS, nos termos do art. 22, § 4º, da Lei nº 8.906/1994; e<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"80\"/><w:ind w:left=\"567\" w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">b) a retenção, pelos CONTRATADOS, dos honorários contratuais e das despesas que tenham comprovadamente adiantado, por compensação com os valores recebidos em nome do(a) CONTRATANTE, nos termos do art. 48, §§ 2º e 3º, do Código de Ética e Disciplina da OAB.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">5.2<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Em até 5 (cinco) dias úteis do efetivo crédito, os CONTRATADOS prestarão contas ao(à) CONTRATANTE, por escrito, com demonstrativo discriminado do valor bruto recebido, dos honorários, das despesas e do saldo, e repassarão o saldo para conta de titularidade do(a) CONTRATANTE: Banco <\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">{{CLI_BANCO}}<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">, agência <\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">{{CLI_AG}}<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">, conta <\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">{{CLI_CONTA}}<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">, chave PIX <\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">{{CLI_PIX}}<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">. A alteração desses dados somente será aceita por solicitação escrita confirmada na forma do item 11.3.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">5.3<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Quando o proveito for pago diretamente ao(à) CONTRATANTE, os honorários deverão ser pagos em até 5 (cinco) dias do recebimento, exclusivamente na seguinte conta:<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"80\"/><w:ind w:left=\"567\" w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">Titular: Arthur Bastos Barcelos Sociedade Individual de Advocacia<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"80\"/><w:ind w:left=\"567\" w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">CNPJ e chave PIX: 68.156.375/0001-89<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"80\"/><w:ind w:left=\"567\" w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">Instituição financeira: Nubank (código 0260) – Agência 0001 – Conta corrente 146093167-5<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">5.4<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> O pagamento poderá ser feito também por boleto bancário, a pedido do(a) CONTRATANTE. Em conformidade com o art. 52 do Código de Ética e Disciplina da OAB, os honorários não serão representados por duplicata ou outro título de crédito de natureza mercantil, podendo ser emitida fatura, quando o(a) CONTRATANTE assim pretender, a qual não será levada a protesto.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">5.5<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> O atraso no pagamento sujeitará o(a) CONTRATANTE a correção monetária pelo IPCA, juros de mora de 1% (um por cento) ao mês e multa de <\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">{{MULTA}}<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> sobre o valor em atraso, podendo os CONTRATADOS promover desde logo a execução deste contrato, na forma da Cláusula Décima Segunda.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">5.6<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Os pagamentos realizados serão quitados mediante recibo ou nota fiscal emitidos pelos CONTRATADOS. O pagamento feito à sociedade indicada no item 5.3 dá quitação em relação a todos os CONTRATADOS, que ajustarão entre si a divisão dos honorários.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:pStyle w:val=\"Title\"/><w:spacing w:before=\"280\" w:after=\"140\"/><w:ind w:right=\"-41\"/><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">CLÁUSULA SEXTA – DAS DESPESAS DO PROCESSO<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">6.1<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Não estão incluídas nos honorários e serão custeadas pelo(a) CONTRATANTE todas as despesas judiciais e extrajudiciais necessárias à condução do caso, tais como custas, taxas, emolumentos, honorários periciais e de assistente técnico, certidões, autenticações, cópias, diligências de oficial de justiça, contratação de correspondentes em outras comarcas e, quando necessários e previamente ajustados, deslocamentos para fora da região metropolitana de Belo Horizonte, viagens, hospedagem e alimentação.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">6.2<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> As despesas serão solicitadas previamente, com a indicação de sua finalidade, e deverão ser antecipadas pelo(a) CONTRATANTE no prazo indicado na solicitação. Os CONTRATADOS comprovarão as despesas por recibos, notas fiscais, guias ou outro meio idôneo.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">6.3<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Sendo o caso, os CONTRATADOS requererão o benefício da gratuidade da justiça com base nas informações e documentos fornecidos pelo(a) CONTRATANTE, que responde por sua veracidade. Indeferido ou revogado o benefício, as despesas serão custeadas pelo(a) CONTRATANTE.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">6.4<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Se os CONTRATADOS adiantarem alguma despesa, o(a) CONTRATANTE a reembolsará, com correção monetária, em até 5 (cinco) dias do recebimento do demonstrativo, sem prejuízo da retenção prevista no item 5.1, alínea \"b\". Os valores adiantados pelo(a) CONTRATANTE que sobejarem serão devolvidos na prestação de contas final.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">6.5<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> O(A) CONTRATANTE declara ter sido informado(a) de que, em caso de insucesso, eventual condenação ao pagamento de custas e de honorários de sucumbência em favor da parte contrária é de sua exclusiva responsabilidade, observada a suspensão de exigibilidade em caso de gratuidade da justiça (art. 98, § 3º, do Código de Processo Civil).<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:pStyle w:val=\"Title\"/><w:spacing w:before=\"280\" w:after=\"140\"/><w:ind w:right=\"-41\"/><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">CLÁUSULA SÉTIMA – DOS HONORÁRIOS DE SUCUMBÊNCIA<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">7.1<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Os honorários de sucumbência fixados em favor do advogado da causa pertencem exclusivamente aos CONTRATADOS, nos termos dos arts. 22, 23 e 24 da Lei nº 8.906/1994, e são autônomos e cumuláveis com os honorários contratuais, não se confundindo nem se compensando com estes, observado o limite do item 4.5.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">7.2<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Nos termos do art. 24, § 4º, da Lei nº 8.906/1994, o acordo feito pelo(a) CONTRATANTE com a parte contrária, salvo aquiescência dos CONTRATADOS, não lhes prejudica os honorários, quer os convencionados, quer os de sucumbência. O(A) CONTRATANTE não poderá dispor, renunciar ou transigir sobre a verba sucumbencial sem anuência expressa dos CONTRATADOS.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">7.3<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Em caso de falecimento ou incapacidade civil de advogado integrante dos CONTRATADOS, os honorários de sucumbência, proporcionais ao trabalho realizado, serão recebidos por seus sucessores ou representantes legais, na forma do art. 24, § 2º, da Lei nº 8.906/1994.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:pStyle w:val=\"Title\"/><w:spacing w:before=\"280\" w:after=\"140\"/><w:ind w:right=\"-41\"/><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">CLÁUSULA OITAVA – DA DESISTÊNCIA, DA REVOGAÇÃO, DO ACORDO DIRETO E DA CONTRATAÇÃO DE OUTRO ADVOGADO<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">8.1<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> O(A) CONTRATANTE poderá desistir deste contrato, sem qualquer ônus, no prazo de 7 (sete) dias contados da assinatura, desde que os CONTRATADOS ainda não tenham praticado nenhum ato, judicial ou extrajudicial, em seu favor. Praticado qualquer ato, aplica-se o item 8.2.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">8.2<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> A revogação do mandato sem justa causa ou a desistência imotivada da ação pelo(a) CONTRATANTE não o(a) desobriga do pagamento dos honorários, nos termos do art. 17 do Código de Ética e Disciplina da OAB, que serão devidos proporcionalmente ao trabalho realizado até a data da revogação ou desistência, da seguinte forma:<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"80\"/><w:ind w:left=\"567\" w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">a) havendo proveito econômico, ainda que obtido posteriormente e com atuação de outro profissional, pela aplicação do percentual cabível na forma dos itens 4.2 a 4.4, na proporção dos serviços prestados pelos CONTRATADOS; ou<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"80\"/><w:ind w:left=\"567\" w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">b) não havendo proveito econômico, ou sendo impossível apurá-lo, pelo valor dos atos praticados segundo a Tabela de Honorários da OAB/MG vigente, não inferior a <\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">{{MIN_TXT}}<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">Na falta de consenso quanto ao valor proporcional, este será fixado por arbitramento judicial, nos termos do art. 22, § 2º, da Lei nº 8.906/1994, sem prejuízo dos honorários de sucumbência proporcionais ao trabalho realizado.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">8.3<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Serão devidos integralmente os honorários previstos na Cláusula Quarta, calculados sobre o valor do acordo ou do proveito econômico pretendido ou reconhecido, quando o(a) CONTRATANTE:<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"80\"/><w:ind w:left=\"567\" w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">a) celebrar acordo diretamente com a parte contrária sem a participação dos CONTRATADOS;<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"80\"/><w:ind w:left=\"567\" w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">b) renunciar ao direito, desistir da ação ou do cumprimento de sentença após decisão que lhe tenha sido favorável; ou<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"80\"/><w:ind w:left=\"567\" w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">c) receber valores diretamente e deixar de informá-los aos CONTRATADOS, na forma do item 3.1, alínea \"e\".<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">8.4<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Equipara-se à desistência imotivada, para os fins do item 8.2, a extinção do processo causada por omissão do(a) CONTRATANTE no fornecimento de documentos, no comparecimento a atos ou no custeio de despesas, desde que previamente notificado(a) pelos canais oficiais e mantido(a) inerte.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">8.5<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Os valores devidos com base no item 8.2, alínea \"b\", vencem em 10 (dez) dias da revogação, da desistência ou da notificação; os demais, no recebimento do proveito econômico.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">8.6<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Caso o(a) CONTRATANTE contrate outro advogado para atuar no objeto deste contrato em substituição aos CONTRATADOS, será devido a estes o valor proporcional ao trabalho realizado até a data da substituição, apurado na forma do item 8.2, além dos honorários de sucumbência proporcionais, nos termos do art. 17 do Código de Ética e Disciplina da OAB.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">8.7<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Equipara-se à substituição a juntada aos autos de procuração outorgada a outro advogado sem reserva dos poderes conferidos aos CONTRATADOS. A contratação de outro advogado para atuar em conjunto com os CONTRATADOS deverá ser comunicada a estes previamente e por escrito e não reduz os honorários ajustados neste contrato.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">8.8<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Para assegurar o recebimento do valor proporcional, os CONTRATADOS poderão juntar este contrato aos autos e requerer a reserva de seus honorários, bem como informar ao advogado que os suceder o valor que lhes é devido.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:pStyle w:val=\"Title\"/><w:spacing w:before=\"280\" w:after=\"140\"/><w:ind w:right=\"-41\"/><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">CLÁUSULA NONA – DA RENÚNCIA DOS CONTRATADOS<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">9.1<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Os CONTRATADOS poderão renunciar ao mandato a qualquer tempo, sem necessidade de declinar o motivo, nos termos do art. 16 do Código de Ética e Disciplina da OAB, especialmente em caso de quebra de confiança ou de descumprimento contratual pelo(a) CONTRATANTE, mediante notificação escrita enviada por e-mail ou WhatsApp.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">9.2<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Comunicada a renúncia, os CONTRATADOS continuarão a representar o(a) CONTRATANTE durante os 10 (dez) dias seguintes à notificação, salvo se substituídos antes, praticando os atos necessários para evitar-lhe prejuízo, nos termos do art. 5º, § 3º, da Lei nº 8.906/1994 e do art. 112 do Código de Processo Civil.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">9.3<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Na renúncia motivada por descumprimento contratual ou por conduta do(a) CONTRATANTE que quebre a relação de confiança, aplica-se integralmente o item 8.2. Na renúncia sem essa motivação, os CONTRATADOS farão jus apenas aos honorários proporcionais calculados sobre o proveito econômico eventualmente obtido, na forma do item 8.2, alínea \"a\", e aos honorários de sucumbência proporcionais.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:pStyle w:val=\"Title\"/><w:spacing w:before=\"280\" w:after=\"140\"/><w:ind w:right=\"-41\"/><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">CLÁUSULA DÉCIMA – DA CONDUÇÃO TÉCNICA E DO USO DE INTELIGÊNCIA ARTIFICIAL<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">10.1<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> A condução técnica do processo é de responsabilidade dos CONTRATADOS, que atuarão com autonomia e independência, inclusive quanto à decisão de interpor ou não recursos, após informar o(a) CONTRATANTE sobre as razões e os riscos envolvidos. A não interposição de recurso fundamentada em avaliação técnica não configura inércia ou desídia.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">10.2<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Os CONTRATADOS informam que utilizam sistemas de inteligência artificial como ferramenta auxiliar de trabalho, em observância à Recomendação nº 001/2024 do Conselho Federal da OAB, de 11 de novembro de 2024, limitada a atividades de apoio, como pesquisa de legislação e jurisprudência, organização e sumarização de documentos, elaboração de minutas, revisão de texto e rotinas administrativas.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">10.3<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> A definição da tese, da estratégia e do conteúdo de cada peça é exclusivamente humana, cabendo aos CONTRATADOS a revisão integral de todo material produzido com auxílio de inteligência artificial antes de qualquer uso. Nenhuma decisão relativa aos interesses do(a) CONTRATANTE será tomada de forma automatizada.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:rig