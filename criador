      values.D_NOME = values.D_NOMEU = need('D_NOME', d.nome && d.nome.toUpperCase(), 'Nome do declarante');
      values.D_CPF = need('D_CPF', d.cpf, 'CPF do declarante');
      values.D_QUALIF = ', ' + need(tk, d.nac, 'Declarante: nacionalidade') + ', ' + need(tk, d.ec, 'Declarante: estado civil') + ', ' +
        need(tk, d.prof, 'Declarante: profissão') + ', ' + g(gd, 'portador', 'portadora', 'portador(a)') + ' do RG nº ' + need(tk, d.rg, 'Declarante: RG') +
        ', ' + g(gd, 'inscrito', 'inscrita', 'inscrito(a)') + ' no CPF sob o nº ' + need(tk, d.cpf, 'Declarante: CPF') + ', residente e ' +
        g(gd, 'domiciliado', 'domiciliada', 'domiciliado(a)') + ' na ' + need(tk, d.end, 'Declarante: endereço') + ', CEP ' + need(tk, d.cep, 'Declarante: CEP') +
        ', e-mail ' + need(tk, d.email, 'Declarante: e-mail');
    } else {
      values.D_NOME = values.D_NOMEU = need('D_NOME', null, 'Declarante pessoa física');
    }
    flags.SIT = !!st.sit;
    var renda = parseMoney(st.renda);
    values.RENDA = renda != null ? moedaCurta(renda) : 'R$ ' + need('RENDA', flags.SIT ? null : '-', 'Renda mensal');
    set('DEPENDENTES', st.dependentes, 'Nº de dependentes');
    set('DESPESAS', st.despesas, 'Despesas fixas');

    // fechamento
    var dt = dataExtenso(st.data);
    values.DATA = dt || BLANK + ' de ' + BLANK + ' de ' + BLANK;
    if (!dt) (miss.DATA = []).push('Data de assinatura');
    ['T1_NOME', 'T1_CPF', 'T2_NOME', 'T2_CPF'].forEach(function (k) { values[k] = (st[k] || '').trim() || BLANK; });

    return { values: values, flags: flags, lists: lists, miss: miss, somaParcelas: soma, iniTotal: iniTotal };
  }

  /* pendências de um documento: tokens que ele usa, respeitando os blocos opcionais */
  function missingFor(tokens, res) {
    var out = [], seen = {};
    var optional = { REC_PCT_TXT: 'REC', REC_TRIB: 'REC', PER_PARC: 'PER', RENDA: 'SIT', DEPENDENTES: 'SIT', DESPESAS: 'SIT', EXCLUSAO: 'EXCLUSAO' };
