Bold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">1.1<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> O presente contrato tem por objeto a prestação de serviços advocatícios pelos CONTRATADOS em favor do(a) CONTRATANTE, consistentes em <\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">{{OBJ_SERVICO}}<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> em face de <\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">{{PARTE_CONTRARIA}}<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">, com o objetivo de <\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">{{OBJ_RESULTADO}}<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">1.2<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> O patrocínio abrange todos os atos necessários à condução da demanda descrita no item 1.1, em qualquer juízo, instância ou tribunal, inclusive a interposição e o acompanhamento de recursos, até <\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">{{EXTENSAO}}<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">, bem como as tratativas extrajudiciais e os requerimentos administrativos a ela diretamente relacionados.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">1.3<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Não estão abrangidos por este contrato, dependendo de novo contrato ou de aditivo escrito, com honorários próprios:<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"80\"/><w:ind w:left=\"567\" w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">a) ações autônomas ou incidentais distintas da descrita no item 1.1, tais como ação rescisória, mandado de segurança, embargos de terceiro, reclamação constitucional e ações conexas;<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"80\"/><w:ind w:left=\"567\" w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">b) defesa em ações propostas pela parte contrária ou por terceiros em autos apartados;<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"80\"/><w:ind w:left=\"567\" w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">c) procedimentos administrativos, criminais, trabalhistas ou de outra natureza não descritos no item 1.1<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">{{EXC_FIM}}<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"80\"/><w:ind w:left=\"567\" w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">⟦IF:EXCLUSAO⟧<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">d) <\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">{{EXCLUSAO}}<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:pStyle w:val=\"Title\"/><w:spacing w:before=\"280\" w:after=\"140\"/><w:ind w:right=\"-41\"/><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">CLÁUSULA SEGUNDA – DAS OBRIGAÇÕES DOS CONTRATADOS<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">2.1<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Os CONTRATADOS obrigam-se a prestar os serviços com zelo, diligência, lealdade e independência técnica, empregando os meios jurídicos cabíveis na defesa dos direitos do(a) CONTRATANTE, em observância ao Estatuto da Advocacia e ao Código de Ética e Disciplina da OAB.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">2.2<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Os CONTRATADOS manterão o(a) CONTRATANTE informado(a) sobre o andamento do processo, prestarão os esclarecimentos solicitados pelos canais oficiais previstos na Cláusula Décima Segunda e o(a) informarão, de forma clara, sobre os riscos da demanda e suas possíveis consequências, inclusive em caso de insucesso.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">2.3<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Os CONTRATADOS prestarão contas ao(à) CONTRATANTE de todos os valores recebidos em seu nome, na forma da Cláusula Sexta.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">2.4<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> A obrigação assumida pelos CONTRATADOS é de meio, e não de resultado. Não há garantia de êxito, de valor ou de prazo, que dependem de fatores alheios à atuação profissional, como as provas disponíveis, a interpretação do Poder Judiciário e a conduta da parte contrária.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">2.5<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Os atos poderão ser praticados por qualquer dos CONTRATADOS ou por advogados integrantes de sua equipe, sem que isso configure infração contratual. Os CONTRATADOS poderão substabelecer os poderes com reserva; o substabelecimento sem reserva de poderes dependerá do prévio e inequívoco conhecimento do(a) CONTRATANTE, nos termos do art. 26, § 1º, do Código de Ética e Disciplina da OAB.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">2.6<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> Os CONTRATADOS guardarão sigilo profissional sobre todos os fatos e informações de que tomarem conhecimento em razão deste contrato, dever que subsiste após o seu término.<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:pStyle w:val=\"Title\"/><w:spacing w:before=\"280\" w:after=\"140\"/><w:ind w:right=\"-41\"/><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">CLÁUSULA TERCEIRA – DAS OBRIGAÇÕES DO(A) CONTRATANTE<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"120\"/><w:ind w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:rFonts w:ascii=\"Spectral SemiBold\" w:cs=\"Spectral SemiBold\" w:eastAsia=\"Spectral SemiBold\" w:hAnsi=\"Spectral SemiBold\"/><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">3.1<\/w:t><\/w:r><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\"> O(A) CONTRATANTE obriga-se a:<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"80\"/><w:ind w:left=\"567\" w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">a) pagar os honorários iniciais nas datas e nos valores indicados na tabela do item 4.3, independentemente de aviso ou cobrança, e os honorários de êxito na forma da Cláusula Sexta;<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"80\"/><w:ind w:left=\"567\" w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">b) fornecer, nos prazos solicitados, os documentos e as informações necessários à condução do caso, responsabilizando-se por sua veracidade, integridade e autenticidade;<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"80\"/><w:ind w:left=\"567\" w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">c) comparecer, quando convocado(a), a audiências, perícias, reuniões e demais atos em que sua presença seja necessária;<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"80\"/><w:ind w:left=\"567\" w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">d) manter atualizados seu endereço, telefone, e-mail e dados bancários, comunicando por escrito qualquer alteração;<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"80\"/><w:ind w:left=\"567\" w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">e) não manter tratativas nem celebrar acordo diretamente com a parte contrária, seus advogados ou prepostos sem a ciência e a participação dos CONTRATADOS, encaminhando-lhes imediatamente qualquer proposta ou contato recebido;<\/w:t><\/w:r><\/w:p><w:p><w:pPr><w:spacing w:after=\"80\"/><w:ind w:left=\"567\" w:right=\"-41\"/><w:rPr><w:sz w:val=\"22\"/><\/w:rPr><\/w:pPr><w:r><w:rPr><w:sz w:val=\"22\"/><w:szCs w:val=\"22\"/><\/w:rPr><w:t xml:space=\"preserve\">f) informar aos CONTRATADOS, no prazo de 48 (quarenta e oito) horas, 